{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "mocha", "chai"],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "@plugins/*": ["../plugins/*"],
      "@utilities/*": ["./unit-tests/utilities/*"],
      "@services/*": ["./unit-tests/Services/*"]
    }
  },
  "include": ["unit-tests/**/*.ts", "unit-tests/**/*.js"],
  "ts-node": {
    "esm": true,
    "transpileOnly": true
  }
}
