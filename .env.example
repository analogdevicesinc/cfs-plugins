# Local test configuration — copy to .env and adjust for your machine.
# .env is gitignored; values here are loaded by mocha via dotenv/config
# (see .mocharc.json).
#
# These drive the opt-in Zephyr TF-M build test
# (BuildCode_BasicFlow_ShouldSucceed). Every line below is commented out:
# uncomment and fill in the ones you need. Sample values are placeholders,
# not real paths — replace them with your kit's actual install location.

# Opt in to the build test (it needs a real toolchain). Unset/false -> skipped.
# CFS_RUN_BUILD=true

# The cfsutil command the build test runs. Required when CFS_RUN_BUILD=true.
# On Windows point at the installed kit's cfs.cmd; elsewhere this can simply
# be "cfsutil" if it is on PATH.
# CFS_UTIL_CMD=the/path/to/your/cfs/Utils/cfsutil/bin/cfs.cmd

# Kit install dir, e.g. C:/analog/cfs/<ver>. Used by cfsutil / kit tooling.
# CFS_INSTALL_DIR=the/path/to/your/cfs

# Fallbacks for the TFLM module preparation. A TFLM target needs cmsis-dsp,
# cmsis-nn and tflite-micro, which the ADI Zephyr SDK filters out of its west
# workspace by default; the build test fetches them itself, locating the declared
# SDK by reading the package manager's `.cfsPackages` index (the same file
# `cfsutil pkg path` reads) and running the kit's own `west`. Set these only if
# the per-platform defaults do not match your install.
# CFS_PACKAGES_DIR=the/path/to/com.analog.cfs/.../packages
# CFS_WEST_CMD=the/path/to/your/cfs/Tools/python/Scripts/west.exe

# WINDOWS ONLY: build the workspace under a short root so Zephyr/TF-M object
# paths stay under CMake's 250-char CMAKE_OBJECT_PATH_MAX limit. Without this,
# the build test fails on Windows at the compile step. Linux/CI does not need it.
# CFS_BUILD_WORKSPACE_DIR=C:/w
