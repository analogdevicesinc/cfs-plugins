<%~ include("@normalizeSoc", it) %>
{
  "configurations": [
    {
      "name": "CFS: Debug with GDB and OpenOCD (ARM Embedded)",
      "executable": "${config:cfs.programFile}",
      "cwd": "${config:cfs.debugPath}",
      "request": "launch",
      "type": "cortex-debug",
      "runToEntryPoint": "main",
      "servertype": "openocd",
      "serverpath": "${config:cfs.openocd.path}/bin/openocd",
      "linux": {
        "gdbPath": "${cfs:tool.path.arm.zephyr.eabi.toolchain.debuggerPath}-py",
        "objdumpPath": "${cfs:tool.path.arm.zephyr.eabi.toolchain.paths}/arm-zephyr-eabi-objdump"
      },
      "windows": {
        "gdbPath": "${cfs:tool.path.arm.zephyr.eabi.toolchain.debuggerPath}-py.exe",
        "objdumpPath": "${cfs:tool.path.arm.zephyr.eabi.toolchain.paths}/arm-zephyr-eabi-objdump.exe"
      },
      "osx": {
        "gdbPath": "${cfs:tool.path.arm.zephyr.eabi.toolchain.debuggerPath}"
      },
      "svdPath": "${config:cfs.cmsis.svdFile}",
      "searchDir": ["${config:cfs.openocd.path}/share/openocd/scripts"],
      "configFiles": [
        "${config:cfs.openocd.interface}",
        "${config:cfs.openocd.target}"
      ],
      "gdbTarget": "localhost:3333",
      "preLaunchCommands": [
        "set logging overwrite on",
        "set logging file debug-arm.log",
        "set logging on",
        "tbreak abort",
        "tbreak _exit",
        "set remotetimeout 60"
      ],
      "preLaunchTask": "CFS: build"
    },
    {
      "name": "CFS: Debug with JlinkGDBServer and JLink (ARM Embedded)",
      "executable": "${workspaceFolder}/build/zephyr/zephyr.elf",
      "cwd": "${config:cfs.debugPath}",
      "request": "launch",
      "type": "cortex-debug",
      "runToEntryPoint": "main",
      "servertype": "jlink",
      "linux": {
        "serverpath": "${command:cfs.jlink.setJlinkPath}/JLinkGDBServerCLExe",
        "gdbPath": "${cfs:tool.path.arm.zephyr.eabi.toolchain.debuggerPath}-py",
        "objdumpPath": "${cfs:tool.path.arm.zephyr.eabi.toolchain.paths}/arm-zephyr-eabi-objdump"
      },
      "windows": {
        "serverpath": "${command:cfs.jlink.setJlinkPath}/JLinkGDBServerCL.exe",
        "gdbPath": "${cfs:tool.path.arm.zephyr.eabi.toolchain.debuggerPath}-py.exe",
        "objdumpPath": "${cfs:tool.path.arm.zephyr.eabi.toolchain.paths}/arm-zephyr-eabi-objdump.exe"
      },
      "osx": {
        "serverpath": "${command:cfs.jlink.setJlinkPath}/JLinkGDBServerCLExe",
        "gdbPath": "${cfs:tool.path.arm.zephyr.eabi.toolchain.debuggerPath}"
      },
      "device": "${config:cfs.jlink.device}",
      "interface": "swd",
      "svdPath": "${config:cfs.cmsis.svdFile}",
      "gdbTarget": "localhost:2331",
      "preLaunchCommands": [
        "set logging overwrite on",
        "set logging file debug-arm.log",
        "set logging on",
        "tbreak abort",
        "tbreak _exit",
        "set remotetimeout 60"
      ],
      "preLaunchTask": "CFS: build"
    },
    {
      "name": "CFS: Debug with OpenOCD and JLink (ARM Embedded)",
      "executable": "${config:cfs.programFile}",
      "cwd": "${config:cfs.debugPath}",
      "request": "launch",
      "type": "cortex-debug",
      "runToEntryPoint": "main",
      "servertype": "openocd",
      "serverpath": "${config:cfs.openocd.path}/bin/openocd",
      "linux": {
        "gdbPath": "${cfs:tool.path.arm.zephyr.eabi.toolchain.debuggerPath}-py",
        "objdumpPath": "${cfs:tool.path.arm.zephyr.eabi.toolchain.paths}/arm-zephyr-eabi-objdump"
      },
      "windows": {
        "gdbPath": "${cfs:tool.path.arm.zephyr.eabi.toolchain.debuggerPath}-py.exe",
        "objdumpPath": "${cfs:tool.path.arm.zephyr.eabi.toolchain.paths}/arm-zephyr-eabi-objdump.exe"
      },
      "osx": {
        "gdbPath": "${cfs:tool.path.arm.zephyr.eabi.toolchain.debuggerPath}"
      },
      "device": "${config:cfs.jlink.device}",
      "interface": "swd",
      "svdPath": "${config:cfs.cmsis.svdFile}",
      "searchDir": ["${config:cfs.openocd.path}/share/openocd/scripts"],
      "configFiles": ["interface/jlink.cfg", "${config:cfs.openocd.target}"],
      "gdbTarget": "localhost:3333",
      "preLaunchCommands": [
        "set logging overwrite on",
        "set logging file debug-arm.log",
        "set logging on",
        "tbreak abort",
        "tbreak _exit",
        "set remotetimeout 60"
      ],
      "preLaunchTask": "CFS: build"
    <% if (["MAX32650", "MAX32655", "MAX32657", "MAX32658", "MAX32660", "MAX32662", "MAX32666", "MAX32670", "MAX32672", "MAX32690", "MAX78000", "MAX78002"].includes(it.projectInflectionPoint(it.soc))) { %>
    },
    {
      "name": "CFS: Launch Core Dump Analysis",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "external",
      "linux": {
        "gdbPath": "${cfs:tool.path.arm.zephyr.eabi.toolchain.debuggerPath}-py",
        "objdumpPath": "${cfs:tool.path.arm.zephyr.eabi.toolchain.paths}/arm-zephyr-eabi-objdump"
      },
      "windows": {
        "gdbPath": "${cfs:tool.path.arm.zephyr.eabi.toolchain.debuggerPath}-py.exe",
        "objdumpPath": "${cfs:tool.path.arm.zephyr.eabi.toolchain.paths}/arm-zephyr-eabi-objdump.exe"
      },
      "osx": {
        "gdbPath": "${cfs:tool.path.arm.zephyr.eabi.toolchain.debuggerPath}"
      },
      "gdbTarget": "localhost: ${config:cfs.coreDump.gdbServerPort}",
      "svdPath": "${config:cfs.cmsis.svdFile}",
      "executable": "${workspaceFolder}/build/zephyr/zephyr.elf",
      "cwd": "${workspaceFolder}",
      "overrideLaunchCommands": []
<% } %>
   }
  ]
}
