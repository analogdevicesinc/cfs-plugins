<%~ include("@normalizeSoc", it) %>

# Power management
CONFIG_PM=y
CONFIG_PM_DEVICE=y
CONFIG_PM_DEVICE_RUNTIME=y
CONFIG_COUNTER=y

# Logging (immediate mode to avoid deferred work waking the system)
CONFIG_LOG=y
CONFIG_LOG_MODE_IMMEDIATE=y

# Build for debug by default
CONFIG_DEBUG=y

# Enable thread awareness when debugging
CONFIG_THREAD_NAME=y
CONFIG_DEBUG_THREAD_INFO=y
CONFIG_THREAD_ANALYZER=y

# Enable the console and shell on UART0
CONFIG_PRINTK=y

# Set the main stack size to a reasonable value for this application
CONFIG_MAIN_STACK_SIZE=1024

# Enable Zephyr core dump support
CONFIG_DEBUG_COREDUMP=y
CONFIG_DEBUG_COREDUMP_BACKEND_FLASH_PARTITION=y
CONFIG_DEBUG_COREDUMP_MEMORY_DUMP_THREADS=y
CONFIG_FLASH=y