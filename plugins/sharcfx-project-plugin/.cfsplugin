    },
    {
      "name": "ADSP-21835W",
      "board": "EV-SOMCRR-EZKIT",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-21836",
      "board": "ADSP21836-EV-SOM",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-21836",
      "board": "EV-SOMCRR-EZKIT",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-21836W",
      "board": "ADSP21836W-EV-SOM",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-21836W",
      "board": "EV-SOMCRR-EZKIT",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-21837",
      "board": "ADSP21837-EV-SOM",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-21837",
      "board": "EV-SOMCRR-EZKIT",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-21837W",
      "board": "ADSP21837W-EV-SOM",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-21837W",
      "board": "EV-SOMCRR-EZKIT",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-SC834",
      "board": "ADSPSC834-EV-SOM",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-SC834",
      "board": "EV-SOMCRR-EZKIT",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-SC834W",
      "board": "ADSPSC834W-EV-SOM",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-SC834W",
      "board": "EV-SOMCRR-EZKIT",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-SC835",
      "board": "ADSPSC835-EV-SOM",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-SC835",
      "board": "EV-SOMCRR-EZKIT",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-SC835W",
      "board": "ADSPSC835W-EV-SOM",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-SC835W",
      "board": "EV-SOMCRR-EZKIT",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    }
  ],
  "features": {
    "project": {
      "templates": [
        {
          "src": "templates/m33/settings.json.eta",
          "dst": ".vscode/settings.json",
          "condition": "${context.coreId.toLowerCase().includes('m33')}"
        },
        {
          "src": "templates/sfx/settings.json.eta",
          "dst": ".vscode/settings.json",
          "condition": "${context.coreId.toLowerCase().includes('fx')}"
        },
        {
          "src": "templates/m33/launch.json.eta",
          "dst": ".vscode/launch.json",
          "condition": "${context.coreId.toLowerCase().includes('m33')}"
        },
        {
          "src": "templates/sfx/launch.json.eta",
          "dst": ".vscode/launch.json",
          "condition": "${context.coreId.toLowerCase().includes('fx')}"
        },
        {
          "src": "templates/m33/c_cpp_properties.json.eta",
          "dst": ".vscode/c_cpp_properties.json",
          "condition": "${context.coreId.toLowerCase().includes('m33')}"
        },
        {
          "src": "templates/sfx/c_cpp_properties.json.eta",
          "dst": ".vscode/c_cpp_properties.json",
          "condition": "${context.coreId.toLowerCase().includes('fx')}"
        },
        {
          "src": "templates/m33/cfs.tasks.json.eta",
          "dst": ".vscode/cfs.tasks.json",
          "condition": "${context.coreId.toLowerCase().includes('m33')}"
        },
        {
          "src": "templates/sfx/cfs.tasks.json.eta",
          "dst": ".vscode/cfs.tasks.json",
          "condition": "${context.coreId.toLowerCase().includes('fx')}"
        },
        {
          "src": "templates/m33/main.c.eta",
          "dst": "src/main.c",
          "condition": "${context.coreId.toLowerCase().includes('m33')}"
        },
        {
          "src": "templates/sfx/main.c.eta",
          "dst": "src/main.c",
          "condition": "${context.coreId.toLowerCase().includes('fx')}"
        },
        {
          "src": "templates/m33/Makefile.eta",
          "dst": "Makefile",
          "condition": "${context.coreId.toLowerCase().includes('m33')}"
        },
        {
          "src": "templates/sfx/Makefile.eta",
          "dst": "Makefile",
          "condition": "${context.coreId.toLowerCase().includes('fx')}"
        },
        {
          "src": "templates/m33/project.mk.eta",
          "dst": "project.mk",
          "condition": "${context.coreId.toLowerCase().includes('m33')}"
        },
        {
          "src": "templates/sfx/project.mk.eta",
          "dst": "project.mk",
          "condition": "${context.coreId.toLowerCase().includes('fx')}"
        },
        {
          "src": "templates/system/adi_initialize.c.eta",
          "dst": "src/system/adi_initialize.c",
          "condition": "${context.coreId.toLowerCase().includes('fx')}"
        },
        {
          "src": "templates/system/adi_initialize.h.eta",
          "dst": "src/system/adi_initialize.h",
          "condition": "${context.coreId.toLowerCase().includes('fx')}"
        },
        {
          "src": "templates/ozone-project.jdebug.eta",
          "dst": "m33.jdebug",
          "condition": "${context.coreId.toLowerCase().includes('m33')}"
        },
        {
          "src": "templates/m33/ADSP-SC83x.ld.eta",
          "dst": "ADSP-SC83x.ld"
        }
      ],
      "files": [
        {
          "src": "files/sfx/specs",
          "dst": "src/linker",
          "condition": "${context.coreId.toLowerCase().includes('fx')}"
        },
        {
          "src": "files/.cfsdependencies",
          "dst": ".cfs"
        }
      ]
    },
    "codegen": {
      "templates": [
        {
          "src": "templates/aimodels_sfx.mk.eta",
          "dst": "aimodels.mk",
          "condition": "${((context.cfsconfig.Projects?.find(p => p.ProjectId == context.projectId).AIModels?.length ?? 0) > 0) && context.coreId.toLowerCase().includes('fx')}"
        },
        {
          "src": "templates/aimodels_m33.mk.eta",
          "dst": "aimodels.mk",
          "condition": "${((context.cfsconfig.Projects?.find(p => p.ProjectId == context.projectId).AIModels?.length ?? 0) > 0) && context.coreId.toLowerCase().includes('m33')}"
        },
        {
          "src": "templates/soc_init.c.eta",
          "dst": "src/system/soc_init.c",
          "condition": "${context.coreId.toLowerCase().includes('m33')}"
        },
        {
          "src": "templates/soc_init.c.eta",
          "dst": "src/system/soc_init.c",
          "condition": "${context.coreId.toLowerCase().includes('fx')}"
        },
        {
          "src": "templates/sfx/memmap.xmm.eta",
          "dst": "src/linker/memmap.xmm",
          "condition": "${context.coreId.toLowerCase().includes('fx')}"
        },
        {
          "src": "templates/m33/memory.ld.eta",
          "dst": "memory.ld",
          "condition": "${context.coreId.toLowerCase().includes('m33')}"
        }
      ],
      "files": []
    }
  },
  "properties": {
    "project": [
      {
        "id": "ProjectName",
        "name": "Project Name",
        "category": "Project Settings",
        "default": "${context.coreId}",
        "type": "string",
        "required": true,
        "readonly": false
      }
    ],
    "memory": {
      "addedControls": [
        {
          "Id": "NAME_OVERRIDE",
          "Description": "Memory Region Name Override",
          "Type": "text",
          "Pattern": "[_a-zA-Z][_a-zA-Z0-9]*",
          "Scope": "${CoreId} ${String: memory regions} +"
        },
        {
          "Id": "SECTIONS",
          "Description": "Sections to be mapped to this partition. Multiple values can be separated by spaces.",
          "Type": "text",
          "Pattern": "([._a-zA-Z][._a-zA-Z0-9]*)?( +[._a-zA-Z][._a-zA-Z0-9]*)*",
          "Condition": "${CoreId} ${String:FX} ="
        },
        {
          "Id": "STACK",
          "Description": "Use for Stack",
          "Type": "boolean",
          "Condition": "${CoreId} ${String:FX} =",
          "Scope": "${CoreId} ${String: stack} +"
        },
        {
          "Id": "HEAP",
          "Description": "Use for Heap",
          "Type": "boolean",
          "Condition": "${CoreId} ${String:FX} =",
          "Scope": "${CoreId} ${String: heap} +"
        },
        {
          "Id": "KERNEL",
          "Description": "Kernel Accessibility",
          "EnumValues": [
            {
              "Id": "ILLEGAL",
              "Description": "Illegal",
              "Value": 0
            },
            {
              "Id": "R",
              "Description": "Read",
              "Value": 1
            },
            {
              "Id": "W",
              "Description": "Write",
              "Value": 2
            },
            {
              "Id": "X",
              "Description": "Execute",
              "Value": 3
            },
            {
              "Id": "RW",
              "Description": "Read/Write",
              "Value": 4
            },
            {
              "Id": "RX",
              "Description": "Read/Execute",
              "Value": 5
            },
            {
              "Id": "RWX",
              "Description": "Read/Write/Execute",
              "Value": 6
            }
          ],
          "Type": "enum",
          "Hint": "RWX",
          "Condition": "${CoreId} ${String:FX} ="
        },
        {
          "Id": "USER",
          "Description": "User Accessibility",
          "EnumValues": [
            {
              "Id": "ILLEGAL",
              "Description": "Illegal",
              "Value": 0,
              "Condition": "${Control:KERNEL} ${String:W} !="
            },
            {
              "Id": "R",
              "Description": "Read",
              "Value": 1,
              "Condition": "${Control:KERNEL} ${String:R} = ${Control:KERNEL} ${String:RW} = |"
            },
            {
              "Id": "W",
              "Description": "Write",
              "Value": 2,
              "Condition": "${Control:KERNEL} ${String:W} ="
            },
            {
              "Id": "X",
              "Description": "Execute",
              "Value": 3,
              "Condition": "${Control:KERNEL} ${String:ILLEGAL} ="
            },
            {
              "Id": "RW",
              "Description": "Read/Write",
              "Value": 4,
              "Condition": "${Control:KERNEL} ${String:RW} ="
            },
            {
              "Id": "RX",
              "Description": "Read/Execute",
              "Value": 5,
              "Condition": "${Control:KERNEL} ${String:RX} = ${Control:KERNEL} ${String:RWX} = |"
            },
            {
              "Id": "RWX",
              "Description": "Read/Write/Execute",
              "Value": 6,
              "Condition": "${Control:KERNEL} ${String:RW} = ${Control:KERNEL} ${String:RWX} = |"
            }
          ],
          "Type": "enum",
          "Hint": "ILLEGAL",
          "Condition": "${CoreId} ${String:FX} ="
        },
        {
          "Id": "CACHEABILITY",
          "Description": "Cacheability",
          "EnumValues": [
            {
              "Id": "DEV",
              "Description": "Device",
              "Value": 0
            },
            {
              "Id": "NC",
              "Description": "Non-Cacheable",
              "Value": 1
            },
            {
              "Id": "WT",
              "Description": "Writethrough",
              "Value": 2
            },
            {
              "Id": "WB",
              "Description": "Writeback",
              "Value": 3
            }
          ],
          "Type": "enum",
          "Hint": "WB",
          "Condition": "${CoreId} ${String:FX} ="
        },
        {
          "Id": "ALLOCATE",
          "Description": "Cache Line Allocate Strategy",
          "EnumValues": [
            {
              "Id": "NONE",
              "Description": "No Allocate",
              "Value": 0,
              "Condition": "${Control:CACHEABILITY} ${String:WT} ="
            },
            {
              "Id": "R",
              "Description": "Allocate on Read",
              "Value": 1
            },
            {
              "Id": "RW",
              "Description": "Allocate on Read and Write",
              "Value": 2
            }
          ],
          "Type": "enum",
          "Hint": "RW",
          "Condition": "${CoreId} ${String:FX} = ${Control:CACHEABILITY} ${String:WT} = ${Control:CACHEABILITY} ${String:WB} = | &"
        },
        {
          "Id": "BUFFERABLE",
          "Description": "Bufferable",
          "Type": "boolean",
          "Condition": "${CoreId} ${String:FX} = ${Control:CACHEABILITY} ${String:DEV} = ${Control:CACHEABILITY} ${String:NC} = | &"
        },
        {
          "Id": "INTERRUPTIBLE",
          "Description": "Interruptible",
          "Type": "boolean",
          "Condition": "${CoreId} ${String:FX} = ${Control:CACHEABILITY} ${String:DEV} = &"
        },
        {
          "Id": "SHAREABILITY",
          "Description": "Shareability",
          "EnumValues": [
            {
              "Id": "NS",
              "Description": "Not Shared",
              "Value": 0
            },
            {
              "Id": "SS",
              "Description": "System Shared",
              "Value": 3
            }
          ],
          "Type": "enum",
          "Hint": "NS",
          "Condition": "${CoreId} ${String:FX} = ${Control:CACHEABILITY} ${String:DEV} != &"
        }
      ]
    },
    "peripheral": {}
  }
}
