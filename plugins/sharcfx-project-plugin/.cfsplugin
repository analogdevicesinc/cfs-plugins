{
  "pluginName": "SHARC-FX Plugin",
  "pluginId": "com.analog.project.sharcfx.plugin",
  "pluginDescription": "SHARC-FX project and code generation.",
  "pluginVersion": "1.3.0",
  "schemaVersion": "1.2.0",
  "pluginApiVersion": 1,
  "author": "Analog Devices, Inc.",
  "firmwarePlatform": "SHARC-FX",
  "supportedHostPlatforms": [
    "windows",
    "linux"
  ],
  "supportedSocs": [
    {
      "name": "ADSP-21834",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-21834W",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-21835",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-21835W",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-21836",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-21836W",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-21837",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-21837W",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-SC834",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-SC834W",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-SC835",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-SC835W",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-21844",
      "package": "bga_ed",
      "dataModelVersion": "^1.0.0"
    },
    {
      "name": "ADSP-21844W",
      "package": "bga_ed",
      "dataModelVersion": "^1.0.0"
    },
    {
      "name": "ADSP-21846",
      "package": "bga_ed",
      "dataModelVersion": "^1.0.0"
    },
    {
      "name": "ADSP-21846W",
      "package": "bga_ed",
      "dataModelVersion": "^1.0.0"
    },
    {
      "name": "ADSP-SC844",
      "package": "bga_ed",
      "dataModelVersion": "^1.0.0"
    },
    {
      "name": "ADSP-SC844W",
      "package": "bga_ed",
      "dataModelVersion": "^1.0.0"
    },
    {
      "name": "ADSP-SC846",
      "package": "bga_ed",
      "dataModelVersion": "^1.0.0"
    },
    {
      "name": "ADSP-SC846W",
      "package": "bga_ed",
      "dataModelVersion": "^1.0.0"
    }
  ],
  "features": {
    "project": {
      "templates": [
        {
          "src": "templates/m33/settings.json.eta",
          "dst": ".vscode/settings.json",
          "condition": "${context.coreId.toLowerCase().includes('m33')}"
        },
        {
          "src": "templates/sfx/settings.json.eta",
          "dst": ".vscode/settings.json",
          "condition": "${context.coreId.toLowerCase().includes('fx')}"
        },
        {
          "src": "templates/m33/launch.json.eta",
          "dst": ".vscode/launch.json",
          "condition": "${context.coreId.toLowerCase().includes('m33')}"
        },
        {
          "src": "templates/sfx/launch.json.eta",
          "dst": ".vscode/launch.json",
          "condition": "${context.coreId.toLowerCase().includes('fx')}"
        },
        {
          "src": "templates/m33/c_cpp_properties.json.eta",
          "dst": ".vscode/c_cpp_properties.json",
          "condition": "${context.coreId.toLowerCase().includes('m33')}"
        },
        {
          "src": "templates/sfx/c_cpp_properties.json.eta",
          "dst": ".vscode/c_cpp_properties.json",
          "condition": "${context.coreId.toLowerCase().includes('fx')}"
        },
        {
          "src": "templates/m33/cfs.tasks.json.eta",
          "dst": ".vscode/cfs.tasks.json",
          "condition": "${context.coreId.toLowerCase().includes('m33')}"
        },
        {
          "src": "templates/sfx/cfs.tasks.json.eta",
          "dst": ".vscode/cfs.tasks.json",
          "condition": "${context.coreId.toLowerCase().includes('fx')}"
        },
        {
          "src": "templates/m33/main.c.eta",
          "dst": "src/main.c",
          "condition": "${context.coreId.toLowerCase().includes('m33')}"
        },
        {
          "src": "templates/sfx/main.c.eta",
          "dst": "src/main.c",
          "condition": "${context.coreId.toLowerCase().includes('fx')}"
        },
        {
          "src": "templates/m33/Makefile.eta",
          "dst": "Makefile",
          "condition": "${context.coreId.toLowerCase().includes('m33')}"
        },
        {
          "src": "templates/sfx/Makefile.eta",
          "dst": "Makefile",
          "condition": "${context.coreId.toLowerCase().includes('fx')}"
        },
        {
          "src": "templates/m33/project.mk.eta",
          "dst": "project.mk",
          "condition": "${context.coreId.toLowerCase().includes('m33')}"
        },
        {
          "src": "templates/sfx/project.mk.eta",
          "dst": "project.mk",
          "condition": "${context.coreId.toLowerCase().includes('fx')}"
        },
        {
          "src": "templates/system/adi_initialize.c.eta",
          "dst": "src/system/adi_initialize.c",
          "condition": "${context.coreId.toLowerCase().includes('fx')}"
        },
        {
          "src": "templates/system/adi_initialize.h.eta",
          "dst": "src/system/adi_initialize.h",
          "condition": "${context.coreId.toLowerCase().includes('fx')}"
        },
        {
          "src": "templates/m33/ADSP-SC83x.ld.eta",
          "dst": "ADSP-SC83x.ld"
        },
        {
          "src": "templates/.cfsdependencies.eta",
          "dst": ".cfs/.cfsdependencies"
        }
      ],
      "files": [
        {
          "src": "files/sharcfx/scripts/gen-xt-substitute-path.sh",
          "dst": ".vscode/gen-xt-substitute-path.sh",
          "condition": "${context.coreId.toLowerCase().includes('fx')}"
        },
        {
          "src": "files/sharcfx-qemu/scripts/qemu-gdbserver.py",
          "dst": ".vscode/qemu-gdbserver.py",
          "condition": "${context.coreId.toLowerCase().includes('m33')}"
        },
        {
          "src": "files/sfx/specs",
          "dst": "src/linker",
          "condition": "${context.coreId.toLowerCase().includes('fx')}"
        }
      ]
    },
    "codegen": {
      "templates": [
        {
          "src": "templates/sfx/aimodels.mk.eta",
          "dst": "aimodels.mk",
          "condition": "${context.coreId.toLowerCase().includes('fx')}"
        },
        {
          "src": "templates/m33/aimodels.mk.eta",
          "dst": "aimodels.mk",
          "condition": "${((context.cfsconfig.Projects ?. find(p => p.ProjectId == context.projectId) .AIModels ?. length ?? 0) > 0) && context.coreId.toLowerCase().includes('m33')}"
        },
        {
          "src": "templates/soc_init.c.eta",
          "dst": "src/system/soc_init.c",
          "condition": "${context.coreId.toLowerCase().includes('m33')}"
        },
        {
          "src": "templates/soc_init.c.eta",
          "dst": "src/system/soc_init.c",
          "condition": "${context.coreId.toLowerCase().includes('fx')}"
        },
        {
          "src": "templates/sfx/memmap.xmm.eta",
          "dst": "src/linker/memmap.xmm",
          "condition": "${context.coreId.toLowerCase().includes('fx')}"
        },
        {
          "src": "templates/m33/memory.ld.eta",
          "dst": "memory.ld",
          "condition": "${context.coreId.toLowerCase().includes('m33')}"
        },
        {
          "src": "templates/config.mk.eta",
          "dst": "config.mk"
        },
        {
          "src": "templates/ssdd/adi_asrc_config_SC8xx.h.eta",
          "dst": "${context.coreId.toLowerCase().includes('fx') ? 'include/ssdd/drivers/asrc/adi_asrc_config_SC8xx.h' : 'include/ssdd/adi_asrc_config_SC8xx.h'}",
          "condition": "${context.cfsconfig.Projects?.find(p => p.ProjectId == context.projectId).Peripherals?.some(p => ['ASRC0', 'ASRC1'].includes(p.Name))}"
        },
        {
          "src": "templates/ssdd/adi_canfd_config_SC8xx.h.eta",
          "dst": "${context.coreId.toLowerCase().includes('fx') ? 'include/ssdd/drivers/canfd/adi_canfd_config_SC8xx.h' : 'include/ssdd/adi_canfd_config_SC8xx.h'}",
          "condition": "${context.cfsconfig.Projects?.find(p => p.ProjectId == context.projectId).Peripherals?.some(p => ['CANFD0', 'CANFD1'].includes(p.Name))}"
        },
        {
          "src": "templates/ssdd/adi_counter_config_SC8xx.h.eta",
          "dst": "${context.coreId.toLowerCase().includes('fx') ? 'include/ssdd/drivers/rotary/adi_counter_config_SC8xx.h' : 'include/ssdd/adi_counter_config_SC8xx.h'}",
          "condition": "${context.cfsconfig.Projects?.find(p => p.ProjectId == context.projectId).Peripherals?.some(p => p.Name === 'CNT0')}"
        },
        {
          "src": "templates/ssdd/adi_crc_config_SC8xx.h.eta",
          "dst": "${context.coreId.toLowerCase().includes('fx') ? 'include/ssdd/drivers/crc/adi_crc_config_SC8xx.h' : 'include/ssdd/adi_crc_config_SC8xx.h'}",
          "condition": "${context.cfsconfig.Projects?.find(p => p.ProjectId == context.projectId).Peripherals?.some(p => ['CRC0', 'CRC1', 'CRC2', 'CRC3'].includes(p.Name))}"
        },
        {
          "src": "templates/ssdd/adi_emsi_config_SC8xx.h.eta",
          "dst": "${context.coreId.toLowerCase().includes('fx') ? 'include/ssdd/drivers/emsi/adi_emsi_config_SC8xx.h' : 'include/ssdd/adi_emsi_config_SC8xx.h'}",
          "condition": "${context.cfsconfig.Projects?.find(p => p.ProjectId == context.projectId).Peripherals?.some(p => p.Name === 'EMSI0')}"
        },
        {
          "src": "templates/ssdd/adi_mdma_config_SC8xx.h.eta",
          "dst": "${context.coreId.toLowerCase().includes('fx') ? 'include/ssdd/services/mdma/adi_mdma_config_SC8xx.h' : 'include/ssdd/adi_mdma_config_SC8xx.h'}",
          "condition": "${context.cfsconfig.Projects?.find(p => p.ProjectId == context.projectId).Peripherals?.some(p => ['EMDMA0', 'EMDMA1'].includes(p.Name))}"
        },
        {
          "src": "templates/ssdd/adi_mlb_config_SC8xx.h.eta",
          "dst": "${context.coreId.toLowerCase().includes('fx') ? 'include/ssdd/drivers/mlb/adi_mlb_config_SC8xx.h' : 'include/ssdd/adi_mlb_config_SC8xx.h'}",
          "condition": "${context.cfsconfig.Projects?.find(p => p.ProjectId == context.projectId).Peripherals?.some(p => p.Name === 'MLB0')}"
        },
        {
          "src": "templates/ssdd/adi_pdm_config_SC8xx.h.eta",
          "dst": "${context.coreId.toLowerCase().includes('fx') ? 'include/ssdd/services/pdm/adi_pdm_config_SC8xx.h' : 'include/ssdd/adi_pdm_config_SC8xx.h'}",
          "condition": "${context.cfsconfig.Projects?.find(p => p.ProjectId == context.projectId).Peripherals?.some(p => ['PDM0', 'PDM1'].includes(p.Name))}"
        },
        {
          "src": "templates/ssdd/adi_pdma_config_SC8xx.h.eta",
          "dst": "${context.coreId.toLowerCase().includes('fx') ? 'include/ssdd/services/pdma/adi_pdma_config_SC8xx.h' : 'include/ssdd/adi_pdma_config_SC8xx.h'}",
          "condition": "${context.cfsconfig.Projects?.find(p => p.ProjectId == context.projectId).Peripherals?.some(p => p.Name.startsWith('DMA'))}"
        },
        {
          "src": "templates/ssdd/adi_spdif_rx_config_SC8xx.h.eta",
          "dst": "${context.coreId.toLowerCase().includes('fx') ? 'include/ssdd/drivers/spdif/adi_spdif_rx_config_SC8xx.h' : 'include/ssdd/adi_spdif_rx_config_SC8xx.h'}",
          "condition": "${context.cfsconfig.Projects?.find(p => p.ProjectId == context.projectId).Peripherals?.some(p => ['SPDIF0', 'SPDIF1'].includes(p.Name))}"
        },
        {
          "src": "templates/ssdd/adi_spdif_tx_config_SC8xx.h.eta",
          "dst": "${context.coreId.toLowerCase().includes('fx') ? 'include/ssdd/drivers/spdif/adi_spdif_tx_config_SC8xx.h' : 'include/ssdd/adi_spdif_tx_config_SC8xx.h'}",
          "condition": "${context.cfsconfig.Projects?.find(p => p.ProjectId == context.projectId).Peripherals?.some(p => ['SPDIF0', 'SPDIF1'].includes(p.Name))}"
        },
        {
          "src": "templates/ssdd/adi_spi_config_SC8xx.h.eta",
          "dst": "${context.coreId.toLowerCase().includes('fx') ? 'include/ssdd/drivers/spi/adi_spi_config_SC8xx.h' : 'include/ssdd/adi_spi_config_SC8xx.h'}",
          "condition": "${context.cfsconfig.Projects?.find(p => p.ProjectId == context.projectId).Peripherals?.some(p => ['SPI0', 'SPI1', 'SPI2', 'SPI5'].includes(p.Name))}"
        },
        {
          "src": "templates/ssdd/adi_sport_config_SC8xx.h.eta",
          "dst": "${context.coreId.toLowerCase().includes('fx') ? 'include/ssdd/drivers/sport/adi_sport_config_SC8xx.h' : 'include/ssdd/adi_sport_config_SC8xx.h'}",
          "condition": "${context.cfsconfig.Projects?.find(p => p.ProjectId == context.projectId).Peripherals?.some(p => ['SPORT0', 'SPORT1', 'SPORT2', 'SPORT3', 'SPORT4', 'SPORT5', 'SPORT6', 'SPORT7'].includes(p.Name))}"
        },
        {
          "src": "templates/ssdd/adi_swu_config_SC8xx.h.eta",
          "dst": "${context.coreId.toLowerCase().includes('fx') ? 'include/ssdd/services/swu/adi_swu_config_SC8xx.h' : 'include/ssdd/adi_swu_config_SC8xx.h'}",
          "condition": "${context.cfsconfig.Projects?.find(p => p.ProjectId == context.projectId).Peripherals?.some(p => ['SWU0', 'SWU1', 'SWU2', 'SWU3', 'SWU4', 'SWU5', 'SWU6', 'SWU7', 'SWU8', 'SWU9', 'SWU10', 'SWU11', 'SWU12', 'SWU13'].includes(p.Name))}"
        },
        {
          "src": "templates/ssdd/adi_tmr_config_SC8xx.h.eta",
          "dst": "${context.coreId.toLowerCase().includes('fx') ? 'include/ssdd/services/tmr/adi_tmr_config_SC8xx.h' : 'include/ssdd/adi_tmr_config_SC8xx.h'}",
          "condition": "${context.cfsconfig.Projects?.find(p => p.ProjectId == context.projectId).Peripherals?.some(p => p.Name === 'TIMER0')}"
        },
        {
          "src": "templates/ssdd/adi_trng_config_SC8xx.h.eta",
          "dst": "${context.coreId.toLowerCase().includes('fx') ? 'include/ssdd/drivers/crypto/adi_trng_config_SC8xx.h' : 'include/ssdd/adi_trng_config_SC8xx.h'}",
          "condition": "${context.cfsconfig.Projects?.find(p => p.ProjectId == context.projectId).Peripherals?.some(p => p.Name === 'TRNG0')}"
        },
        {
          "src": "templates/ssdd/adi_twi_config_SC8xx.h.eta",
          "dst": "${context.coreId.toLowerCase().includes('fx') ? 'include/ssdd/drivers/twi/adi_twi_config_SC8xx.h' : 'include/ssdd/adi_twi_config_SC8xx.h'}",
          "condition": "${context.cfsconfig.Projects?.find(p => p.ProjectId == context.projectId).Peripherals?.some(p => ['TWI0', 'TWI1', 'TWI2', 'TWI3', 'TWI4', 'TWI5'].includes(p.Name))}"
        },
        {
          "src": "templates/ssdd/adi_uart_config_SC8xx.h.eta",
          "dst": "${context.coreId.toLowerCase().includes('fx') ? 'include/ssdd/drivers/uart/adi_uart_config_SC8xx.h' : 'include/ssdd/adi_uart_config_SC8xx.h'}",
          "condition": "${context.cfsconfig.Projects?.find(p => p.ProjectId == context.projectId).Peripherals?.some(p => ['UART0', 'UART1', 'UART2'].includes(p.Name))}"
        },
        {
          "src": "templates/ssdd/adi_xspi_config_SC8xx.h.eta",
          "dst": "${context.coreId.toLowerCase().includes('fx') ? 'include/ssdd/drivers/xspi/adi_xspi_config_SC8xx.h' : 'include/ssdd/adi_xspi_config_SC8xx.h'}",
          "condition": "${context.cfsconfig.Projects?.find(p => p.ProjectId == context.projectId).Peripherals?.some(p => p.Name === 'XSPI' || p.Name === 'XSPI0')}"
        }
      ],
      "files": []
    }
  },
  "properties": {
    "project": [
      {
        "id": "ProjectName",
        "name": "Project Name",
        "category": "Project Settings",
        "default": "${context.coreId}",
        "type": "string",
        "required": true,
        "readonly": false
      }
    ],
    "memory": {
      "addedControls": [
        {
          "Id": "NAME_OVERRIDE",
          "Description": "Memory Region Name Override",
          "Type": "text",
          "Pattern": "[_a-zA-Z][_a-zA-Z0-9]*",
          "Scope": "${CoreId} ${String: memory regions} +"
        },
        {
          "Id": "SECTIONS",
          "Description": "Sections to be mapped to this partition. Each section should be entered on a separate line.",
          "Type": "text_list",
          "Pattern": "([._a-zA-Z][._a-zA-Z0-9]*)?",
          "Condition": "${CoreId} ${String:FX} =",
          "PersistenceSeparator": " "
        },
        {
          "Id": "STACK",
          "Description": "Use for Stack",
          "Type": "boolean",
          "Condition": "${CoreId} ${String:FX} =",
          "Scope": "${CoreId} ${String: stack} +"
        },
        {
          "Id": "HEAP",
          "Description": "Use for Heap",
          "Type": "boolean",
          "Condition": "${CoreId} ${String:FX} =",
          "Scope": "${CoreId} ${String: heap} +"
        },
        {
          "Id": "KERNEL",
          "Description": "Kernel Accessibility",
          "EnumValues": [
            {
              "Id": "ILLEGAL",
              "Description": "Illegal",
              "Value": 0
            },
            {
              "Id": "R",
              "Description": "Read",
              "Value": 1
            },
            {
              "Id": "W",
              "Description": "Write",
              "Value": 2
            },
            {
              "Id": "X",
              "Description": "Execute",
              "Value": 3
            },
            {
              "Id": "RW",
              "Description": "Read/Write",
              "Value": 4
            },
            {
              "Id": "RX",
              "Description": "Read/Execute",
              "Value": 5
            },
            {
              "Id": "RWX",
              "Description": "Read/Write/Execute",
              "Value": 6
            }
          ],
          "Type": "enum",
          "Hint": "RWX",
          "Condition": "${CoreId} ${String:FX} ="
        },
        {
          "Id": "USER",
          "Description": "User Accessibility",
          "EnumValues": [
            {
              "Id": "ILLEGAL",
              "Description": "Illegal",
              "Value": 0,
              "Condition": "${Control:KERNEL} ${String:W} !="
            },
            {
              "Id": "R",
              "Description": "Read",
              "Value": 1,
              "Condition": "${Control:KERNEL} ${String:R} = ${Control:KERNEL} ${String:RW} = |"
            },
            {
              "Id": "W",
              "Description": "Write",
              "Value": 2,
              "Condition": "${Control:KERNEL} ${String:W} ="
            },
            {
              "Id": "X",
              "Description": "Execute",
              "Value": 3,
              "Condition": "${Control:KERNEL} ${String:ILLEGAL} ="
            },
            {
              "Id": "RW",
              "Description": "Read/Write",
              "Value": 4,
              "Condition": "${Control:KERNEL} ${String:RW} ="
            },
            {
              "Id": "RX",
              "Description": "Read/Execute",
              "Value": 5,
              "Condition": "${Control:KERNEL} ${String:RX} = ${Control:KERNEL} ${String:RWX} = |"
            },
            {
              "Id": "RWX",
              "Description": "Read/Write/Execute",
              "Value": 6,
              "Condition": "${Control:KERNEL} ${String:RW} = ${Control:KERNEL} ${String:RWX} = |"
            }
          ],
          "Type": "enum",
          "Hint": "ILLEGAL",
          "Condition": "${CoreId} ${String:FX} ="
        },
        {
          "Id": "CACHEABILITY",
          "Description": "Cacheability",
          "EnumValues": [
            {
              "Id": "DEV",
              "Description": "Device",
              "Value": 0
            },
            {
              "Id": "NC",
              "Description": "Non-Cacheable",
              "Value": 1
            },
            {
              "Id": "WT",
              "Description": "Writethrough",
              "Value": 2
            },
            {
              "Id": "WB",
              "Description": "Writeback",
              "Value": 3
            }
          ],
          "Type": "enum",
          "Hint": "WB",
          "Condition": "${CoreId} ${String:FX} ="
        },
        {
          "Id": "ALLOCATE",
          "Description": "Cache Line Allocate Strategy",
          "EnumValues": [
            {
              "Id": "NONE",
              "Description": "No Allocate",
              "Value": 0,
              "Condition": "${Control:CACHEABILITY} ${String:WT} ="
            },
            {
              "Id": "R",
              "Description": "Allocate on Read",
              "Value": 1
            },
            {
              "Id": "RW",
              "Description": "Allocate on Read and Write",
              "Value": 2
            }
          ],
          "Type": "enum",
          "Hint": "RW",
          "Condition": "${CoreId} ${String:FX} = ${Control:CACHEABILITY} ${String:WT} = ${Control:CACHEABILITY} ${String:WB} = | &"
        },
        {
          "Id": "BUFFERABLE",
          "Description": "Bufferable",
          "Type": "boolean",
          "Condition": "${CoreId} ${String:FX} = ${Control:CACHEABILITY} ${String:DEV} = ${Control:CACHEABILITY} ${String:NC} = | &"
        },
        {
          "Id": "INTERRUPTIBLE",
          "Description": "Interruptible",
          "Type": "boolean",
          "Condition": "${CoreId} ${String:FX} = ${Control:CACHEABILITY} ${String:DEV} = &"
        },
        {
          "Id": "SHAREABILITY",
          "Description": "Shareability",
          "EnumValues": [
            {
              "Id": "NS",
              "Description": "Not Shared",
              "Value": 0
            },
            {
              "Id": "SS",
              "Description": "System Shared",
              "Value": 3
            }
          ],
          "Type": "enum",
          "Hint": "NS",
          "Condition": "${CoreId} ${String:FX} = ${Control:CACHEABILITY} ${String:DEV} != &"
        }
      ]
    },
    "peripheral": {
      "ASRC0": {
        "addedControls": [
          {
            "Id": "ASRC0_INPUT_FORMAT",
            "Description": "Input Format for ASRC0",
            "EnumValues": [
              {
                "Id": "LEFT_JUSTIFIED",
