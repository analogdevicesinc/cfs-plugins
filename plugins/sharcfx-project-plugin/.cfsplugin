{
  "pluginName": "SHARC-FX Plugin",
  "pluginId": "com.analog.project.sharcfx.plugin",
  "pluginDescription": "SHARC-FX project and code generation.",
  "pluginVersion": "1.2.0",
  "schemaVersion": "1.2.0",
  "pluginApiVersion": 1,
  "author": "Analog Devices, Inc.",
  "firmwarePlatform": "SHARC-FX",
  "supportedHostPlatforms": [
    "windows",
    "linux"
  ],
  "supportedSocs": [
    {
      "name": "ADSP-21834",
      "board": "ADSP21834-EV-SOM",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-21834",
      "board": "EV-SOMCRR-EZKIT",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-21834W",
      "board": "ADSP21834W-EV-SOM",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-21834W",
      "board": "EV-SOMCRR-EZKIT",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-21835",
      "board": "ADSP21835-EV-SOM",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-21835",
      "board": "EV-SOMCRR-EZKIT",
      "package": "bga_ed",
      "dataModelVersion": "^1.3.355"
    },
    {
      "name": "ADSP-21835W",
      "board": "ADSP21835W-EV-SOM",
