              {
                "Id": "NO_COMPARE",
                "Description": "No Address Comparison",
                "Value": 0
              },
              {
                "Id": "EXACT_MATCH",
                "Description": "Exact Match on Lower Address",
                "Value": 1
              },
              {
                "Id": "MATCH_WITHIN_RANGE",
                "Description": "Match on Address Within Range",
                "Value": 2
              },
              {
                "Id": "MATCH_OUTSIDE_RANGE",
