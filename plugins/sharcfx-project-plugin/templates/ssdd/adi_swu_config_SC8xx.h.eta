*/
#define ADI_SWU8_GRP2_ScaleMode					<%= getPeriConfigValue("SWU8", "GRP2_SCALE_MODE", "NO_SCALE") %> 

/*! Selects the channel of operation for the SWU8 Group2.
Following are the valid values that can be assigned to the macro

	ADDRESS_CHANNEL - Monitors Address Channel.
	
