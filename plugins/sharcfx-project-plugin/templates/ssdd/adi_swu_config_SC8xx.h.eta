/*!
* @file      adi_swu_config_SC8xx.h
*
* @brief     System Watchpoint Unit (SWU) service static configuration header file
*
* @details
*            System Watchpoint Unit (SWU) service static configuration header file
*/

#ifndef ADI_SWU_CONFIG_SC8XX_H
#define ADI_SWU_CONFIG_SC8XX_H

#include <sys/platform.h>
#include <stdint.h>

#if defined(__ADSPSHARCFX__) && defined(__ADSPSC835_FAMILY__)
/*!For ADSP-SC835 family of processors:
 * Specifies if the SEC interrupts should be used for SWU instances
 * When set to 1, the SEC interrupt path is enabled
 * When set to 0, the direct interrupt path is enabled

 * For ADSP-SC84x Processor, the SWU module supports only SEC interrupts*/
<%
  var _g_sec_int = [
    getAssignedPeripheral("SWU1") ? getPeriConfigValueBoolAsInt("SWU1", "SEC_INT", "TRUE") : null,
    getAssignedPeripheral("SWU2") ? getPeriConfigValueBoolAsInt("SWU2", "SEC_INT", "TRUE") : null,
    getAssignedPeripheral("SWU3") ? getPeriConfigValueBoolAsInt("SWU3", "SEC_INT", "TRUE") : null,
    getAssignedPeripheral("SWU4") ? getPeriConfigValueBoolAsInt("SWU4", "SEC_INT", "TRUE") : null,
    getAssignedPeripheral("SWU5") ? getPeriConfigValueBoolAsInt("SWU5", "SEC_INT", "TRUE") : null,
    getAssignedPeripheral("SWU7") ? getPeriConfigValueBoolAsInt("SWU7", "SEC_INT", "TRUE") : null,
    getAssignedPeripheral("SWU8") ? getPeriConfigValueBoolAsInt("SWU8", "SEC_INT", "TRUE") : null,
    getAssignedPeripheral("SWU11") ? getPeriConfigValueBoolAsInt("SWU11", "SEC_INT", "TRUE") : null,
    getAssignedPeripheral("SWU12") ? getPeriConfigValueBoolAsInt("SWU12", "SEC_INT", "TRUE") : null,
    getAssignedPeripheral("SWU13") ? getPeriConfigValueBoolAsInt("SWU13", "SEC_INT", "TRUE") : null,
  ].filter(v => v !== null);
%> 
#define ADI_SWU_CONFIG_SEC_INT	(<%= _g_sec_int.length ? _g_sec_int[0] : getPeriConfigValueBoolAsInt("SWU1", "SEC_INT", "TRUE") %>u)
<%
  if (_g_sec_int.length > 1 && !_g_sec_int.every(v => v === _g_sec_int[0])) {
%> 
#error "ADI_SWU_CONFIG_SEC_INT: all assigned SWU instances must have the same SEC_INT setting"
<% } %> 
#endif

/* Assign the macros to 1 to those SWU watchpoint groups for which static configuration needs to be done. If macro is 
assigned to 1, then static configuration will be done for the corresponding SWU watchpoint group. If macro is assigned to 0,
static configuration will not be done and the default reset configuration is retained. */

/*!Enable the static configuration for SWU1*/
#define ADI_SWU_SWU1	<%= getPeriConfigValueBoolAsInt("SWU1", "STATIC_CFG", "TRUE") %> 
/*!Enable the static configuration for SWU2*/
#define ADI_SWU_SWU2	<%= getPeriConfigValueBoolAsInt("SWU2", "STATIC_CFG", "TRUE") %> 
/*!Enable the static configuration for SWU7*/
#define ADI_SWU_SWU7	<%= getPeriConfigValueBoolAsInt("SWU7", "STATIC_CFG", "TRUE") %> 
/*!Enable the static configuration for SWU8*/
#define ADI_SWU_SWU8	<%= getPeriConfigValueBoolAsInt("SWU8", "STATIC_CFG", "TRUE") %> 
/*!Enable the static configuration for SWU11*/
#define ADI_SWU_SWU11	<%= getPeriConfigValueBoolAsInt("SWU11", "STATIC_CFG", "TRUE") %> 
/*!Enable the static configuration for SWU12*/
#define ADI_SWU_SWU12	<%= getPeriConfigValueBoolAsInt("SWU12", "STATIC_CFG", "TRUE") %> 
/*!Enable the static configuration for SWU13*/
#define ADI_SWU_SWU13	<%= getPeriConfigValueBoolAsInt("SWU13", "STATIC_CFG", "TRUE") %> 
/*!Enable the static configuration for SWU3*/
#define ADI_SWU_SWU3	<%= getPeriConfigValueBoolAsInt("SWU3", "STATIC_CFG", "TRUE") %> 
/*!Enable the static configuration for SWU4*/
#define ADI_SWU_SWU4	<%= getPeriConfigValueBoolAsInt("SWU4", "STATIC_CFG", "TRUE") %> 
/*!Enable the static configuration for SWU5*/
#define ADI_SWU_SWU5	<%= getPeriConfigValueBoolAsInt("SWU5", "STATIC_CFG", "TRUE") %> 

/*---------------------------------------------------------SWU1--------------------------------------------------------*/
#if (ADI_SWU_SWU1==1)
/*------------------------------------------------------SWU1 Group0------------------------------------*/
/* SWU1 Instance */
/*! Select SWU1 Group0 Instance */
#define ADI_SWU1_GRP0_INSTANCE					<%= getPeriConfigValueBoolAsInt("SWU1", "GRP0_INSTANCE", "TRUE") %>u

/*! Selects the Transaction Direction for SWU1 Group0 Match.
Following are the valid values that can be assigned to the macro

	READ - Match on reads only
	
	WRITE - Match on writes only
*/
#define ADI_SWU1_GRP0_DIRECTION					<%= getPeriConfigValue("SWU1", "GRP0_DIRECTION", "READ") %> 

/*! Selects the Address Comparison Mode for SWU1 Group0 Match.
Following are the valid values that can be assigned to the macro

	NO_COMPARE - No address comparison.
	
	EXACT_MATCH - Exact match on Lower Address.
	
	MATCH_WITHIN_RANGE - Match on address within range.
	
	MATCH_OUTSIDE_RANGE - Match on address outside range.
*/
#define ADI_SWU1_GRP0_ADDRCOMPMODE				<%= getPeriConfigValue("SWU1", "GRP0_ADDRCOMPMODE", "EXACT_MATCH") %> 

/*! In Watchpoint and Bandwidth mode if IDCompEnable = true, SWU1 Group0 group matches based on ID*/
#define ADI_SWU1_GRP0_IDCompEnable				<%= getPeriConfigValueBool("SWU1", "GRP0_ID_COMP_ENABLE", "FALSE") %> 

/*!If set to true, the SWU watchpoint group matches only secure transactions. If set to false, the SWU watchpoint group matches on all transactions*/
#define ADI_SWU1_GRP0_SecureCompEnable			<%= getPeriConfigValueBool("SWU1", "GRP0_SECURE_COMP_ENABLE", "FALSE") %> 

/*! Selects the Count Enable for SWU match. This bit is valid only in Watchpoint mode.*/
/*! If CountEnable = true/false, the cycle count value of the watchpoint group is decremented each cycle until it reaches 0/not decremented.*/
#define ADI_SWU1_GRP0_CountEnable				<%= getPeriConfigValueBool("SWU1", "GRP0_COUNT_ENABLE", "TRUE") %> 

/*! Selects the Count Repeat Enable for SWU match. This bit is valid only in Watchpoint mode.*/
/*! If CountRepeatEn = true/false the cycle count is reloaded and repeated / remains zero after the cycle countdown. */
#define ADI_SWU1_GRP0_CountRepeatEn				<%= getPeriConfigValueBool("SWU1", "GRP0_COUNT_REPEAT_EN", "FALSE") %> 

/*! In Watchpoint and Bandwidth mode if DebugEventEnable = true, SWU watchpoint group matches based on Debug status. */
#define ADI_SWU1_GRP0_DebugEventEnable			<%= getPeriConfigValueBool("SWU1", "GRP0_DEBUG_EVENT_ENABLE", "FALSE") %> 

/*! In Watchpoint and bandwidth mode if InteruptEnable = true, SWU watchpoint group generates an interrupt for a match. */
#define ADI_SWU1_GRP0_InterruptEnable			<%= getPeriConfigValueBool("SWU1", "GRP0_INTERRUPT_ENABLE", "TRUE") %> 

/*! In Watchpoint and bandwidth mode if TriggerEnable = true, SWU watchpoint group generates a trigger event for a match. */
#define ADI_SWU1_GRP0_TriggerEnable				<%= getPeriConfigValueBool("SWU1", "GRP0_TRIGGER_ENABLE", "FALSE") %> 

/*! Selects the mode of operation for the SWU1 Group0.
Following are the valid values that can be assigned to the macro

	WATCHPOINT_MODE - Watchpoint Mode.
	
	BANDWIDTH_MODE - Bandwidth Mode.
*/
#define ADI_SWU1_GRP0_OperationMode				<%= getPeriConfigValue("SWU1", "GRP0_OPERATION_MODE", "WATCHPOINT_MODE") %> 

/*! Selects the Burst Length Increment for Bandwidth Count. This bit is valid only in Bandwidth Mode.*/
/*! If BurstIncrBW = true/false, the SWU match group increments the bandwidth count by burst length of the transaction/ by 1 for each matching transactions. */
#define ADI_SWU1_GRP0_BurstIncrBW				<%= getPeriConfigValueBool("SWU1", "GRP0_BURST_INCR_BW", "FALSE") %> 

/*! Selects Action for Bandwidth Below Minimum. This bit is valid only in Bandwidth Mode.*/
/*! If ActMinBW = true/false, the watchpoint group takes action/no action on bandwidth underflow*/
#define ADI_SWU1_GRP0_ActMinBW					<%= getPeriConfigValueBool("SWU1", "GRP0_ACT_MIN_BW", "FALSE") %> 

/*! Selects Action for Bandwidth Above Maximum. This bit is valid only in Bandwidth Mode.*/
/*! If ActMaxBW = true/false, the watchpoint group takes action/no action on bandwidth overflow*/
#define ADI_SWU1_GRP0_ActMaxBW					<%= getPeriConfigValueBool("SWU1", "GRP0_ACT_MAX_BW", "FALSE") %> 

/*! Selects the Stall Count Mode. This bit is valid only in Bandwidth Mode. */
/*! If set to true, the number of stalls are counted. If set to false, the number of transactions are counted.*/
#define ADI_SWU1_GRP0_StallCountMode			<%= getPeriConfigValueBool("SWU1", "GRP0_STALL_COUNT_MODE", "FALSE") %> 

/*! In Bandwidth mode, scales the number of transactions and clock cycles by 10, 100 and 1000.
Following are the valid values that can be assigned to the macro

	NO_SCALE - No scaling.
	
	SCALE_10 - Scale the transactions by 10.
	
	SCALE_100 - Scale the transactions by 100.
	
	SCALE_1000 - Scale the transactions by 1000.
*/
#define ADI_SWU1_GRP0_ScaleMode					<%= getPeriConfigValue("SWU1", "GRP0_SCALE_MODE", "NO_SCALE") %> 

/*! Selects the channel of operation for the SWU1 Group0.
Following are the valid values that can be assigned to the macro

	ADDRESS_CHANNEL - Monitors Address Channel.
	
	DATA_CHANNEL - Monitors Data Channel Monitor.
*/
#define ADI_SWU1_GRP0_Channel					<%= getPeriConfigValue("SWU1", "GRP0_CHANNEL", "ADDRESS_CHANNEL") %> 

