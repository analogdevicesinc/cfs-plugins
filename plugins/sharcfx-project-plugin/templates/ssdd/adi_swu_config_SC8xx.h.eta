#define ADI_SWU11_GRP2_BurstIncrBW				<%= getPeriConfigValueBool("SWU11", "GRP2_BURST_INCR_BW", "FALSE") %> 

/*! Selects Action for Bandwidth Below Minimum. This bit is valid only in Bandwidth Mode.*/
/*! If ActMinBW = true/false, the watchpoint group takes action/no action on bandwidth underflow*/
#define ADI_SWU11_GRP2_ActMinBW					<%= getPeriConfigValueBool("SWU11", "GRP2_ACT_MIN_BW", "FALSE") %> 

/*! Selects Action for Bandwidth Above Maximum. This bit is valid only in Bandwidth Mode.*/
/*! If ActMaxBW = true/false, the watchpoint group takes action/no action on bandwidth overflow*/
#define ADI_SWU11_GRP2_ActMaxBW					<%= getPeriConfigValueBool("SWU11", "GRP2_ACT_MAX_BW", "FALSE") %> 

/*! Selects the Stall Count Mode. This bit is valid only in Bandwidth Mode. */
/*! If set to true, the number of stalls are counted. If set to false, the number of transactions are counted.*/
#define ADI_SWU11_GRP2_StallCountMode			<%= getPeriConfigValueBool("SWU11", "GRP2_STALL_COUNT_MODE", "FALSE") %> 

/*! In Bandwidth mode, scales the number of transactions and clock cycles by 10, 100 and 1000.
Following are the valid values that can be assigned to the macro

	NO_SCALE - No scaling.
	
	SCALE_10 - Scale the transactions by 10.
	
	SCALE_100 - Scale the transactions by 100.
	
	SCALE_1000 - Scale the transactions by 1000.
*/
#define ADI_SWU11_GRP2_ScaleMode				<%= getPeriConfigValue("SWU11", "GRP2_SCALE_MODE", "NO_SCALE") %> 

/*! Selects the channel of operation for the SWU11 Group2.
Following are the valid values that can be assigned to the macro

	ADDRESS_CHANNEL - Monitors Address Channel.
	
	DATA_CHANNEL - Monitors Data Channel Monitor.
*/
#define ADI_SWU11_GRP2_Channel					<%= getPeriConfigValue("SWU11", "GRP2_CHANNEL", "ADDRESS_CHANNEL") %> 

/*------------------------------------------------------SWU11 Group3------------------------------------*/
/* SWU11 Group3 Instance */
/*! Select SWU11 Group3 Instance */
#define ADI_SWU11_GRP3_INSTANCE					<%= getPeriConfigValueBoolAsInt("SWU11", "GRP3_INSTANCE", "TRUE") %>u

/*! Selects the Transaction Direction for SWU11 Group3 Match.
Following are the valid values that can be assigned to the macro

	READ - Match on reads only
	
	WRITE - Match on writes only
*/
#define ADI_SWU11_GRP3_DIRECTION				<%= getPeriConfigValue("SWU11", "GRP3_DIRECTION", "READ") %> 

/*! Selects the Address Comparison Mode for SWU11 Group3 Match.
Following are the valid values that can be assigned to the macro

	NO_COMPARE - No address comparison.
	
	EXACT_MATCH - Exact match on Lower Address.
	
	MATCH_WITHIN_RANGE - Match on address within range.
	
	MATCH_OUTSIDE_RANGE - Match on address outside range.
*/
#define ADI_SWU11_GRP3_ADDRCOMPMODE				<%= getPeriConfigValue("SWU11", "GRP3_ADDRCOMPMODE", "EXACT_MATCH") %> 

/*! In Watchpoint and Bandwidth mode if IDCompEnable = true, SWU11 Group3 group matches based on ID*/
#define ADI_SWU11_GRP3_IDCompEnable				<%= getPeriConfigValueBool("SWU11", "GRP3_ID_COMP_ENABLE", "FALSE") %> 

/*!If set to true, the SWU watchpoint group matches only secure transactions. If set to false, the SWU watchpoint group matches on all transactions*/
#define ADI_SWU11_GRP3_SecureCompEnable			<%= getPeriConfigValueBool("SWU11", "GRP3_SECURE_COMP_ENABLE", "FALSE") %> 

/*! Selects the Count Enable for SWU match. This bit is valid only in Watchpoint mode.*/
/*! If CountEnable = true/false, the cycle count value of the watchpoint group is decremented each cycle until it reaches 0/not decremented.*/
#define ADI_SWU11_GRP3_CountEnable				<%= getPeriConfigValueBool("SWU11", "GRP3_COUNT_ENABLE", "TRUE") %> 

/*! Selects the Count Repeat Enable for SWU match. This bit is valid only in Watchpoint mode.*/
/*! If CountRepeatEn = true/false the cycle count is reloaded and repeated / remains zero after the cycle countdown. */
#define ADI_SWU11_GRP3_CountRepeatEn			<%= getPeriConfigValueBool("SWU11", "GRP3_COUNT_REPEAT_EN", "FALSE") %> 

/*! In Watchpoint and Bandwidth mode if DebugEventEnable = true, SWU watchpoint group matches based on Debug status. */
#define ADI_SWU11_GRP3_DebugEventEnable			<%= getPeriConfigValueBool("SWU11", "GRP3_DEBUG_EVENT_ENABLE", "FALSE") %> 

/*! In Watchpoint and bandwidth mode if InteruptEnable = true, SWU watchpoint group generates an interrupt for a match. */
#define ADI_SWU11_GRP3_InterruptEnable			<%= getPeriConfigValueBool("SWU11", "GRP3_INTERRUPT_ENABLE", "TRUE") %> 

/*! In Watchpoint and bandwidth mode if TriggerEnable = true, SWU watchpoint group generates a trigger event for a match. */
#define ADI_SWU11_GRP3_TriggerEnable			<%= getPeriConfigValueBool("SWU11", "GRP3_TRIGGER_ENABLE", "FALSE") %> 

/*! Selects the mode of operation for the SWU11 Group3.
Following are the valid values that can be assigned to the macro

	WATCHPOINT_MODE - Watchpoint Mode.
	
	BANDWIDTH_MODE - Bandwidth Mode.
*/
#define ADI_SWU11_GRP3_OperationMode			<%= getPeriConfigValue("SWU11", "GRP3_OPERATION_MODE", "WATCHPOINT_MODE") %> 

/*! Selects the Burst Length Increment for Bandwidth Count. This bit is valid only in Bandwidth Mode.*/
/*! If BurstIncrBW = true/false, the SWU match group increments the bandwidth count by burst length of the transaction/ by 1 for each matching transactions. */
#define ADI_SWU11_GRP3_BurstIncrBW				<%= getPeriConfigValueBool("SWU11", "GRP3_BURST_INCR_BW", "FALSE") %> 

/*! Selects Action for Bandwidth Below Minimum. This bit is valid only in Bandwidth Mode.*/
/*! If ActMinBW = true/false, the watchpoint group takes action/no action on bandwidth underflow*/
#define ADI_SWU11_GRP3_ActMinBW					<%= getPeriConfigValueBool("SWU11", "GRP3_ACT_MIN_BW", "FALSE") %> 

/*! Selects Action for Bandwidth Above Maximum. This bit is valid only in Bandwidth Mode.*/
/*! If ActMaxBW = true/false, the watchpoint group takes action/no action on bandwidth overflow*/
#define ADI_SWU11_GRP3_ActMaxBW					<%= getPeriConfigValueBool("SWU11", "GRP3_ACT_MAX_BW", "FALSE") %> 

/*! Selects the Stall Count Mode. This bit is valid only in Bandwidth Mode. */
/*! If set to true, the number of stalls are counted. If set to false, the number of transactions are counted.*/
#define ADI_SWU11_GRP3_StallCountMode			<%= getPeriConfigValueBool("SWU11", "GRP3_STALL_COUNT_MODE", "FALSE") %> 

/*! In Bandwidth mode, scales the number of transactions and clock cycles by 10, 100 and 1000.
Following are the valid values that can be assigned to the macro

	NO_SCALE - No scaling.
	
	SCALE_10 - Scale the transactions by 10.
	
	SCALE_100 - Scale the transactions by 100.
	
	SCALE_1000 - Scale the transactions by 1000.
*/
#define ADI_SWU11_GRP3_ScaleMode				<%= getPeriConfigValue("SWU11", "GRP3_SCALE_MODE", "NO_SCALE") %> 

/*! Selects the channel of operation for the SWU11 Group3.
Following are the valid values that can be assigned to the macro

	ADDRESS_CHANNEL - Monitors Address Channel.
	
	DATA_CHANNEL - Monitors Data Channel Monitor.
*/
#define ADI_SWU11_GRP3_Channel					<%= getPeriConfigValue("SWU11", "GRP3_CHANNEL", "ADDRESS_CHANNEL") %> 

#endif /*(ADI_SWU_SWU11==1)*/

