#define ADI_SWU8_GRP1_ActMaxBW					<%= getPeriConfigValueBool("SWU8", "GRP1_ACT_MAX_BW", "FALSE") %> 

/*! Selects the Stall Count Mode. This bit is valid only in Bandwidth Mode. */
/*! If set to true, the number of stalls are counted. If set to false, the number of transactions are counted.*/
#define ADI_SWU8_GRP1_StallCountMode			<%= getPeriConfigValueBool("SWU8", "GRP1_STALL_COUNT_MODE", "FALSE") %> 

/*! In Bandwidth mode, scales the number of transactions and clock cycles by 10, 100 and 1000.
Following are the valid values that can be assigned to the macro

	NO_SCALE - No scaling.
	
	SCALE_10 - Scale the transactions by 10.
	
	SCALE_100 - Scale the transactions by 100.
	
	SCALE_1000 - Scale the transactions by 1000.
*/
#define ADI_SWU8_GRP1_ScaleMode					<%= getPeriConfigValue("SWU8", "GRP1_SCALE_MODE", "NO_SCALE") %> 

/*! Selects the channel of operation for the SWU8 Group1.
Following are the valid values that can be assigned to the macro

	ADDRESS_CHANNEL - Monitors Address Channel.
	
	DATA_CHANNEL - Monitors Data Channel Monitor.
*/
#define ADI_SWU8_GRP1_Channel					<%= getPeriConfigValue("SWU8", "GRP1_CHANNEL", "ADDRESS_CHANNEL") %> 

/*------------------------------------------------------SWU8 Group2------------------------------------*/
/* SWU8 Group2 Instance */
/*! Select SWU8 Group2 Instance */
#define ADI_SWU8_GRP2_INSTANCE					<%= getPeriConfigValueBoolAsInt("SWU8", "GRP2_INSTANCE", "TRUE") %>u

/*! Selects the Transaction Direction for SWU8 Group2 Match.
