#define ADI_SPI5_CTL_TARGET_SELECT_ENABLE_3            <%= getPeriConfigValueBoolAsInt("SPI5", "TARGET_SELECT_ENABLE_3", "FALSE") %>ul
/*! SPI Target select register \n
    This allows a Target select to be enabled/disabled\n
    (0) - disables the Target select 4\n
    (1) - enables the Target select 4\n*/
#define ADI_SPI5_CTL_TARGET_SELECT_ENABLE_4            <%= getPeriConfigValueBoolAsInt("SPI5", "TARGET_SELECT_ENABLE_4", "FALSE") %>ul
/*! SPI Target select register \n
    This allows a Target select to be enabled/disabled\n
    (0) - disables the Target select 5\n
    (1) - enables the Target select 5\n*/
#define ADI_SPI5_CTL_TARGET_SELECT_ENABLE_5            <%= getPeriConfigValueBoolAsInt("SPI5", "TARGET_SELECT_ENABLE_5", "FALSE") %>ul
/*! SPI Target select register \n
    This allows a Target select to be enabled/disabled\n
    (0) - disables the Target select 6\n
    (1) - enables the Target select 6\n*/
#define ADI_SPI5_CTL_TARGET_SELECT_ENABLE_6            <%= getPeriConfigValueBoolAsInt("SPI5", "TARGET_SELECT_ENABLE_6", "FALSE") %>ul
/*! SPI Target select register \n
    This allows a Target select to be enabled/disabled\n
    (0) - disables the Target select 7\n
    (1) - enables the Target select 7\n*/
#define ADI_SPI5_CTL_TARGET_SELECT_ENABLE_7            <%= getPeriConfigValueBoolAsInt("SPI5", "TARGET_SELECT_ENABLE_7", "FALSE") %>ul

/* Specifies the SPI5 Target select Control register Configuration\n*/
#define ADI_SPI5_CTL_TARGET_SELECT_ENABLE              ((ADI_SPI5_CTL_TARGET_SELECT_ENABLE_7<<BITP_SPI_TSEL_TSE7)|\
                                                       (ADI_SPI5_CTL_TARGET_SELECT_ENABLE_6<<BITP_SPI_TSEL_TSE6)|\
                                                       (ADI_SPI5_CTL_TARGET_SELECT_ENABLE_5<<BITP_SPI_TSEL_TSE5)|\
                                                       (ADI_SPI5_CTL_TARGET_SELECT_ENABLE_4<<BITP_SPI_TSEL_TSE4)|\
                                                       (ADI_SPI5_CTL_TARGET_SELECT_ENABLE_3<<BITP_SPI_TSEL_TSE3)|\
                                                       (ADI_SPI5_CTL_TARGET_SELECT_ENABLE_2<<BITP_SPI_TSEL_TSE2)|\
                                                       (ADI_SPI5_CTL_TARGET_SELECT_ENABLE_1<<BITP_SPI_TSEL_TSE1))
/*****************************************************************************************************************/
#endif /* #if defined(__ADI_HAS_SPI5__)*/
