    (0) - disables the Target select 5\n
    (1) - enables the Target select 5\n*/
#define ADI_SPI2_CTL_TARGET_SELECT_ENABLE_5            <%= getPeriConfigValueBoolAsInt("SPI2", "TARGET_SELECT_ENABLE_5", "FALSE") %>ul
/*! SPI Target select register \n
    This allows a Target select to be enabled/disabled\n
    (0) - disables the Target select 6\n
    (1) - enables the Target select 6\n*/
#define ADI_SPI2_CTL_TARGET_SELECT_ENABLE_6            <%= getPeriConfigValueBoolAsInt("SPI2", "TARGET_SELECT_ENABLE_6", "FALSE") %>ul
/*! SPI Target select register \n
    This allows a Target select to be enabled/disabled\n
    (0) - disables the Target select 7\n
    (1) - enables the Target select 7\n*/
#define ADI_SPI2_CTL_TARGET_SELECT_ENABLE_7            <%= getPeriConfigValueBoolAsInt("SPI2", "TARGET_SELECT_ENABLE_7", "FALSE") %>ul

/* Specifies the SPI2 Target select Control register Configuration\n*/
#define ADI_SPI2_CTL_TARGET_SELECT_ENABLE              ((ADI_SPI2_CTL_TARGET_SELECT_ENABLE_7<<BITP_SPI_TSEL_TSE7)|\
