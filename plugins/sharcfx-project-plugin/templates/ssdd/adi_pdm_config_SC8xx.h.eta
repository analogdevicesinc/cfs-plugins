/* Sets the PDM_SP_CTL0 value */
#define ADI_PDM0_SP_CTL0_VALUE                  ((ADI_PDM0_SP_CTL0_SAI_MODE<<BITP_PDM_SP_CTL0_SAI_MODE)|\
                                                 (ADI_PDM0_SP_CTL0_DATA_FORMAT<<BITP_PDM_SP_CTL0_DATA_FORMAT)|\
												 (ADI_PDM0_SP_CTL0_SLOT_WIDTH<<BITP_PDM_SP_CTL0_CH0_SLOT_WIDTH)|\
												 (ADI_PDM0_SP_CTL0_BCLK_POL<<BITP_PDM_SP_CTL0_BCLK_POL)|\
												 (ADI_PDM0_SP_CTL0_LRCLK_POL<<BITP_PDM_SP_CTL0_LRCLK_POL))
													
/**************************************************************************************************************/

