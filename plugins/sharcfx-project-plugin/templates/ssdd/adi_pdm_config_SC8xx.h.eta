/** @addtogroup PDM_Service
 *  @{
 */

/** @defgroup PDM_Service_Static_Configuration PDM Service Static Configuration
 *  @{

  Static Configuration: Using this configuration application can configure the control register
  parameters upfront which can be set to default. This configuration has macros which can be configured 
  through adi_pdm_config.h file which by default is available with PDM service. Example project can maintain 
  a copy of it locally for custom configuration.

  Default Static Configuration for PDM(0/1): 
  The default configuration for PDM:
        bCh01Enable    : 1
		bCh23Enable    : 1
		eDecRatio	   : ADI_PDM_DEC_RATIO_64 (=0=64x)
		bHPFEnable	   : 0
		eHPFCutOffFreq : ADI_PDM_HPF_CUTOFF_0P00505 (=5=0.00505)
		eSPTMode	   : ADI_PDM_SPT_MODE_STEREO (=0, Stereo mode)	
		eSPTDataDelay  : ADI_PDM_SPT_DATA_DELAY_1 (=1, I2S mode)
		eSPTSlotWidth  : ADI_PDM_SPT_SLOT_WIDTH_32 (=0, 32 bits)
		eSPTBCLKPol	   : ADI_PDM_SPT_BCLK_POL_RISE (=0, sample on rising edge)
		eSPTLRCLKPol   : ADI_PDM_SPT_BCLK_POL_NORMAL (=0, normal polarity)
		uiChSlotMap    : [0, 1, 2, 3] 

  Specifies the PDM(X)_CTL0 register configuration\n
    ADI_PDM(X)_CTL0_CH01_EN	                  (0x1ul)------channels 0 and 1 are enabled \n
	ADI_PDM(X)_CTL0_CH23_EN	                  (0x1ul)------channels 2 and 3 are enabled \n
	ADI_PDM(X)_CTL0_DEC_RATIO	              (0x0ul)------64x decimation ratio \n
	
  Specifies the PDM(X)_HPF_CTL register configuration\n
    ADI_PDM(X)_HPF_CTL_EN	                  (0x1ul)------HPF is enabled \n
	ADI_PDM(X)_HPF_CTL_FC                 	  (0x5ul)------HPF cutoff = 0.00505 \n

  Specifies the PDM(X)_SP_CTL0 register configuration\n
    ADI_PDM(X)_SP_CTL0_SAI_MODE 	          (0x0ul)------stereo mode\n
	ADI_PDM(X)_SP_CTL0_DATA_FORMAT 	          (0x0ul)------I2S mode, delay by 1\n
	ADI_PDM(X)_SP_CTL0_SLOT_WIDTH 	          (0x0ul)------32 bits\n
	ADI_PDM(X)_SP_CTL0_BCLK_POL 	          (0x0ul)------capture on rising edge\n
	ADI_PDM(X)_SP_CTL0_LRCLK_POL 	          (0x0ul)------normal LRCLK polarity\n

  Specifies the PDM(X)_SP_CTL1 register configuration\n
    ADI_PDM(X)_SP_CTL1_CH0_SLOT 	          (0x0ul)------ch0 slot = 0\n
	ADI_PDM(X)_SP_CTL1_CH1_SLOT 	          (0x1ul)------ch1 slot = 1\n
	ADI_PDM(X)_SP_CTL1_CH2_SLOT 	          (0x2ul)------ch2 slot = 2\n
	ADI_PDM(X)_SP_CTL1_CH3_SLOT 	          (0x3ul)------ch3 slot = 3\n

 */

/**
 * @file      adi_pdm_config_SC8xx.h
 *
 * @brief     PDM service static configuration
 *
 * @details   Header File which has the static configuration for PDM instances.
 *
 */

#ifndef ADI_PDM_CONFIG_SC8XX_H
#define ADI_PDM_CONFIG_SC8XX_H

