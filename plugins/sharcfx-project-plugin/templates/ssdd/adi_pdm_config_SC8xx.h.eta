/**************************************************************************************************************/
/*! select/de-select PDM0 Instance */
#define ADI_PDM0_INSTANCE                     <%= getAssignedPeripheral("PDM0") ? "1" : "0" %>ul

/*! select/de-select PDM1 Instance */
#define ADI_PDM1_INSTANCE                     <%= getAssignedPeripheral("PDM1") ? "1" : "0" %>ul

/**********************************************************************************************
 *                                        PDM 0
 **********************************************************************************************/

/***************************************PDM_CTL0****************************************************************/
/*!
   CH01_EN\n
   (0) -  PDM channels 0 and 1 disabled\n 
   (1) -  PDM channels 0 and 1 enabled\n
*/
#define ADI_PDM0_CTL0_CH01_EN					(<%= getPeriConfigValueBoolAsInt("PDM0", "CTL0_CH01_EN", "FALSE") %>u)

/*!
   CH23_EN\n
   (0) -  PDM channels 2 and 3 disabled\n 
   (1) -  PDM channels 2 and 3 enabled\n
*/
#define ADI_PDM0_CTL0_CH23_EN                   (<%= getPeriConfigValueBoolAsInt("PDM0", "CTL0_CH23_EN", "FALSE") %>u)

/*!
   Decimation Ratio\n
   (0) -  64x\n
   (1) -  32x\n
   (2) -  16x\n
*/
#define ADI_PDM0_CTL0_DEC_RATIO                 (<%= getPeriConfigValueEnum("PDM0", "CTL0_DEC_RATIO", "64_X", {"64_X":0,"32_X":1,"16_X":2}) %>u)

/* Sets the PDM_CTL0 value */
#define ADI_PDM0_CTL0_VALUE                  	((ADI_PDM0_CTL0_CH01_EN<<BITP_PDM_CTL0_CH01_EN)|\
                                                 (ADI_PDM0_CTL0_CH23_EN<<BITP_PDM_CTL0_CH23_EN)|\
												 (ADI_PDM0_CTL0_DEC_RATIO<<BITP_PDM_CTL0_DEC_RATIO))
													
/**************************************************************************************************************/

