#define ADI_PDM0_SP_CTL0_SLOT_WIDTH				(<%= getPeriConfigValueEnum("PDM0", "SP_CTL0_SLOT_WIDTH", "32_BITS", {"32_BITS":0,"16_BITS":1,"24_BITS":2}) %>u)

/*!
   BCLK polarity\n
   (0) -  capture on rising edge\n
   (1) -  capture on falling edge\n 
 */
#define ADI_PDM0_SP_CTL0_BCLK_POL				(<%= getPeriConfigValueEnum("PDM0", "SP_CTL0_BCLK_POL", "CAPTURE_RISING_EDGE", {"CAPTURE_RISING_EDGE":0,"CAPTURE_FALLING_EDGE":1}) %>u)

