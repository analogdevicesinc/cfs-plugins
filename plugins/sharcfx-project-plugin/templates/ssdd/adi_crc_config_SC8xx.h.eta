#define CRC1_AUTOCLRZ               <%= getPeriConfigValueBoolAsInt("CRC1", "AUTOCLRZ", "FALSE") %>u
/*! CRC1 enable auto clear to one */
#define CRC1_AUTOCLRF               <%= getPeriConfigValueBoolAsInt("CRC1", "AUTOCLRF", "FALSE") %>u

/*! CRC2 polynomial value */
#define CRC2_POLY_VALUE             <%= getPeriConfigValueInt("CRC2", "POLY_VALUE", "0") %>u
