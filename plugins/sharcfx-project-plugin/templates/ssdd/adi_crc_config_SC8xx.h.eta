/*! CRC0 enable Compare value Mirror */
#define CRC0_CMPMIRR                <%= getPeriConfigValueBoolAsInt("CRC0", "CMPMIRR", "FALSE") %>u
/*! CRC0 enable Auto clear to Zero  */
#define CRC0_AUTOCLRZ               <%= getPeriConfigValueBoolAsInt("CRC0", "AUTOCLRZ", "FALSE") %>u
/*! CRC0 enable Auto set to one */
#define CRC0_AUTOCLRF               <%= getPeriConfigValueBoolAsInt("CRC0", "AUTOCLRF", "FALSE") %>u

/*! CRC1 polynomial value */
