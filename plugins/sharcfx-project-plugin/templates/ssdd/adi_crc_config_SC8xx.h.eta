/*! CRC1 enable Byte mirror */
#define CRC1_BYTMIRR                <%= getPeriConfigValueBoolAsInt("CRC1", "BYTMIRR", "FALSE") %>u
/*! CRC1 enable Word swap */
#define CRC1_W16SWP                 <%= getPeriConfigValueBoolAsInt("CRC1", "W16SWP", "FALSE") %>u
/*! CRC1 select modified or unmodified data for transfer modes */
#define CRC1_FDSEL                  <%= getPeriConfigValueEnum("CRC1", "FDSEL", "UNMODIFIED_DATA", {"UNMODIFIED_DATA":0,"MODIFIED_DATA":1}) %>u
/*! CRC1 enable Result Mirror */
#define CRC1_RSLTMIRR               <%= getPeriConfigValueBoolAsInt("CRC1", "RSLTMIRR", "FALSE") %>u
/*! CRC1 enable Polynomial mirror */
