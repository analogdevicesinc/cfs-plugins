/*! CRC2 enable word swap */
#define CRC2_W16SWP                 <%= getPeriConfigValueBoolAsInt("CRC2", "W16SWP", "FALSE") %>u
/*! CRC2 select modified or unmodified data for transfer modes */
#define CRC2_FDSEL                  <%= getPeriConfigValueEnum("CRC2", "FDSEL", "UNMODIFIED_DATA", {"UNMODIFIED_DATA":0,"MODIFIED_DATA":1}) %>u
/*! CRC2 enable Result Mirror */
#define CRC2_RSLTMIRR               <%= getPeriConfigValueBoolAsInt("CRC2", "RSLTMIRR", "FALSE") %>u
/*! CRC2 enable Polynomial value Mirror*/
#define CRC2_POLYMIRR               <%= getPeriConfigValueBoolAsInt("CRC2", "POLYMIRR", "FALSE") %>u
/*! CRC2 enable Compare value Mirror */
#define CRC2_CMPMIRR                <%= getPeriConfigValueBoolAsInt("CRC2", "CMPMIRR", "FALSE") %>u
