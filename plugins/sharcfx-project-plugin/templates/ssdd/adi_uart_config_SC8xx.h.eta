   (0) -  Send no half stop bit\n
   (1) -  Send one half stop bit\n
   Only for word length with 5 bits, 1.5 Stop bits can be used\n
*/
#define ADI_UART1_CTL_HALF_STOP_BIT             (<%= getPeriConfigValueEnum("UART1", "HALF_STOP_BIT", "SEND_NO_HALF_STOP", {"SEND_NO_HALF_STOP":0,"SEND_ONE_HALF_STOP":1}) %>ul)

/*!
   Parity Enable is used to control of the parity bit\n
   (0) -  Parity will not be transmitted or checked\n
   (1) -  Parity will be transmitted and checked\n
*/
#define ADI_UART1_CTL_ENABLE_PARITY             (<%= getPeriConfigValueEnum("UART1", "ENABLE_PARITY", "PARITY_WILL_NOT_BE", {"PARITY_WILL_NOT_BE":0,"PARITY_WILL_BE_TRANSMITTED":1}) %>ul)

/*!
   Parity Select is required only if parity is enabled\n
   (0) -  Odd parity will be transmitted and checked\n
   (1) -  Even parity will be transmitted and checked\n
*/
#define ADI_UART1_CTL_PARITY_SELECTION          (<%= getPeriConfigValueEnum("UART1", "PARITY_SELECTION", "ODD_PARITY_WILL_BE", {"ODD_PARITY_WILL_BE":0,"EVEN_PARITY_WILL_BE":1}) %>ul)

/*!
   Stop bit selection\n
   (0) -  Send 1 stop bit\n
   (1) -  Send 2 stop bits\n
*/
#define ADI_UART1_CTL_STOP_BIT                  (<%= getPeriConfigValueEnum("UART1", "STOP_BIT", "SEND_1_STOP_BIT", {"SEND_1_STOP_BIT":0,"SEND_2_STOP_BITS":1}) %>ul)

/*!
   UART mode of operation\n
   (0) -  UART mode\n
   (1) -  MDB mode\n
*/
#define ADI_UART1_CTL_MODE_ENABLE               (<%= getPeriConfigValueEnum("UART1", "MODE_ENABLE", "UART", {"UART":0,"MDB":1}) %>ul)

/*!
   Stick Parity is Used to force parity to defined values\n
   (0) -  Hardware calculates the parity based on data bits\n
