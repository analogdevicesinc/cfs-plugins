*/
#define ADI_UART1_CTL_STICKY_PARITY             (<%= getPeriConfigValueEnum("UART1", "STICKY_PARITY", "HARDWARE_CALCULATES_PARITY_BASED", {"HARDWARE_CALCULATES_PARITY_BASED":0,"FORCE_PARITY_DEFINED_VALUE":1}) %>ul)

/*!
   Set Break enables UART_Tx pin to be used as a flag\n
   (0) -  UART_Tx pin not forced\n
   (1) -  UART_Tx pin is forced to zero\n
*/
#define ADI_UART1_CTL_SET_BREAK                 (<%= getPeriConfigValueEnum("UART1", "SET_BREAK", "UART_TX_PIN_NOT", {"UART_TX_PIN_NOT":0,"UART_TX_PIN_FORCED":1}) %>ul)

/*!
   Flow control pin polarity\n
   (0) -  Active low CTS/RTS\n
   (1) -  Active High CTS/RTS\n
*/
#define ADI_UART1_CTL_FLOW_CONTROL_POLARITY     (<%= getPeriConfigValueEnum("UART1", "FLOW_CONTROL_POLARITY", "ACTIVE_LOW", {"ACTIVE_LOW":0,"ACTIVE_HIGH":1}) %>ul)

/*!
   Manual request to send\n
   (0) -  UART deasserts signaling, not ready to receive\n
   (1) -  UART asserts signaling, ready to receive\n
*/
#define ADI_UART1_CTL_MANUAL_SEND_REQ           (<%= getPeriConfigValueBoolAsInt("UART1", "ENABLE_RTS", "FALSE") %>ul)

/*!
   Transmitter off  prevents the data from going to TSR(shift register) from THR(Tx FIFO)\n
   (0) -  Transmission is ON if Automatic CTS is zero\n
   (1) -  Transmission is OFF if Automatic CTS is zero\n
*/
#define ADI_UART1_CTL_TRANSMITTER_OFF           (<%= getPeriConfigValueBool("UART1", "ENABLE_TRANSMITTER", "TRUE") ? 0 : 1 %>ul)

/*!
   Automatic CTS uses Hardware to control the handshaking for Tx\n
   (0) -  Disable automatic Tx handshaking protocol\n
   (1) -  Enable automatic Tx handshaking protocol\n
*/
#define ADI_UART1_CTL_AUTOMATIC_CTS             (<%= getPeriConfigValueBoolAsInt("UART1", "AUTOMATIC_CTS", "FALSE") %>ul)

/*!
   Automatic RTS makes use of Hardware such that UART_RTS pin is controlled with minimal latency\n
   (0) -  Disable automatic Rx handshaking protocol\n
   (1) -  Enable automatic Rx handshaking protocol\n
*/
#define ADI_UART1_CTL_AUTOMATIC_RTS             (<%= getPeriConfigValueBoolAsInt("UART1", "AUTOMATIC_RTS", "FALSE") %>ul)

/*!
   Receive FIFO IRQ Threshold\n
   (0) -  Sets receive FIFO IRQ threshold for count >= 4 bytes\n
   (1) -  Sets receive FIFO IRQ threshold for count >= 7 bytes\n
*/
#define ADI_UART1_CTL_RxFIFO_IRQ_THRESHOLD      (<%= getPeriConfigValueEnum("UART1", "RX_FIFO_IRQ_THRESHOLD", "COUNT_GE_4_BYTES", {"COUNT_GE_4_BYTES":0,"COUNT_GE_7_BYTES":1}) %>ul)

/*!
