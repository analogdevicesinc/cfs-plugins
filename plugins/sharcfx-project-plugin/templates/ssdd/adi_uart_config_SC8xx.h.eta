*/
#define ADI_UART2_CTL_STICKY_PARITY            (<%= getPeriConfigValueEnum("UART2", "STICKY_PARITY", "HARDWARE_CALCULATES_PARITY_BASED", {"HARDWARE_CALCULATES_PARITY_BASED":0,"FORCE_PARITY_DEFINED_VALUE":1}) %>ul)

