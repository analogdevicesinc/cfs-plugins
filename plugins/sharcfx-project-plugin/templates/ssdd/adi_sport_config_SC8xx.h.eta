/*SPORT7B Instance*/
#define ADI_SPORT7B_INSTANCE                     <%= getAssignedPeripheral("SPORT7") ? getPeriConfigValueBoolAsInt("SPORT7", "ENABLE_B", "TRUE") : "0" %> 

