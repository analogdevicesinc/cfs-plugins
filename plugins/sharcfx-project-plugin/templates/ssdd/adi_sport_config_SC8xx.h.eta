 * 			1 : LSB first sent/received (little endian)*/
#define ADI_SPORT7B_CTL_LSBF                         <%= getPeriConfigValueEnum("SPORT7", "B_LSBF", "MSB_FIRST_SENT_RECEIVED", {"MSB_FIRST_SENT_RECEIVED":0,"LSB_FIRST_SENT_RECEIVED":1}) %>ul
