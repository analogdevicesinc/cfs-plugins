<% const hasBoard = Boolean(it.board); %>
<% const _origBoard = it.board; if (!it.board) it.board = ''; %>
<%~ include("@sharcfxBoardName", it) %>
<% it.board = _origBoard; %>
<%~ include("@normalizeSoc", it) %>
<% const openocdInterface = "interface/ice2000.cfg"; %>
<% const emulatorMatch = openocdInterface.match(/ice[-_]?(\d+)/i); %>
<% if (!emulatorMatch) throw new Error(`Unable to determine emulator from OpenOCD interface: ${openocdInterface}`); %>
<% const emulator = emulatorMatch[1]; %>
{
  "C_Cpp.default.forcedInclude": [
    "${workspaceFolder}/build/project_defines.h"
  ],
  "cfs.project.target": "<%= it.projectInflectionPoint(it.soc) %>",
  "cfs.programFile": "${workspaceFolder}/build/${workspaceFolderBasename}.elf",
  "cfs.debugPath": "${workspaceFolder}/build",
  "cfs.project.toolchain.id": "arm.none.eabi.toolchain",
  "cfs.project.sdk.id": "cortex-m-sharcfx",
  "cfs.arm.artifactType": "executable",

  "cfs.openocd.target": "target/<%= it.openocdInflectionPoint(it.soc).toLowerCase() %>.cfg",
  "cfs.openocd.interface": "<%= openocdInterface %>",
<% if (hasBoard) { %>
  "cfs.arm.flash.emulator": "<%= emulator %>",
  "cfs.arm.flash.eraseMode": "affected",
  "cfs.arm.flash.offset": "0x0",
<% } %>

  "cfs.configureWorkspace": "Yes"
}
