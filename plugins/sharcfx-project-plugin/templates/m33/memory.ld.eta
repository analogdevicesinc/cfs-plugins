<%
// Get the core's local alias for the address, if any.
function getCoreAlias(address) {
  const localRegion = getCoreRegion(address, 'Local');
  if (localRegion) {
    let thisAddress = parseInt(address, 16);
    const localStartAddress = parseInt(getRegionProperty(localRegion, 'AddressStart'), 16);
    const offset = address - localStartAddress;
    const aliasStartAddress = parseInt(localRegion.AliasBaseAddress, 16);
    thisAddress = aliasStartAddress + offset;
    return "0x" + thisAddress.toString(16).padStart(8, "0");
  }
  return address;
}
%>
<%~ include("@normalizeSoc", it) %>
<%~ include("@copyrightHeader", it) %>

MEMORY {
<% for (const region of getProject()?.Partitions ?? []) { %>
    <%= getPartitionName(region, "NAME_OVERRIDE").padEnd(maxPartitionNameLength("NAME_OVERRIDE"), " ") %> <%= ("(" + region.Access.toLowerCase().replace(/\//g, "") + ")").padEnd(5, " ") %> : ORIGIN = <%= getCoreAlias(region.StartAddress) %>, LENGTH = 0x<%= region.Size.toString(16).padStart(8, "0") %> /* <%= region.Name.padEnd(maxPartitionNameLength(), " ") %> */
<% } %>
}
