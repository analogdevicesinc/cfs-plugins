<% if (!getProject()?.Partitions.find(p => getPartitionName(p, "NAME_OVERRIDE") === "FLASH")) { %>
    FLASH       (rx)  : ORIGIN = 0x00000000, LENGTH = 0x00000000 /* Section not defined. */
<% } %>
<% if (!getProject()?.Partitions.find(p => getPartitionName(p, "NAME_OVERRIDE") === "PAL_NVM_DB")) { %>
    PAL_NVM_DB  (r)   : ORIGIN = 0x00000000, LENGTH = 0x00000000 /* Section not defined. */
<% } %>
<% if (!getProject()?.Partitions.find(p => getPartitionName(p, "NAME_OVERRIDE") === "SPIX")) { %>
    SPIX        (rx)  : ORIGIN = 0x08000000, LENGTH = 128M
<% } %>
<% if (!getProject()?.Partitions.find(p => getPartitionName(p, "NAME_OVERRIDE") === "OTP")) { %>
    OTP         (rwx) : ORIGIN = 0x00000000, LENGTH = 0x00000000 /* Section not defined. */
<% } %>
<% if (!getProject()?.Partitions.find(p => getPartitionName(p, "NAME_OVERRIDE") === "ARM_SHARED")) { %>
    ARM_SHARED  (rwx) : ORIGIN = 0x00000000, LENGTH = 0x00000000 /* Section not defined. */
<% } %>
<% if (!getProject()?.Partitions.find(p => getPartitionName(p, "NAME_OVERRIDE") === "SDMA_SHARED")) { %>
    SDMA_SHARED (rwx) : ORIGIN = 0x00000000, LENGTH = 0x00000000 /* Section not defined. */
<% } %>
<% if (!getProject()?.Partitions.find(p => getPartitionName(p, "NAME_OVERRIDE") === "SDMA_DATA")) { %>
    SDMA_DATA   (rwx) : ORIGIN = 0x00000000, LENGTH = 0x00000000 /* Section not defined. */
<% } %>
<% if (!getProject()?.Partitions.find(p => getPartitionName(p, "NAME_OVERRIDE") === "SDMA_CODE")) { %>
    SDMA_CODE   (rwx) : ORIGIN = 0x00000000, LENGTH = 0x00000000 /* Section not defined. */
<% } %>
<% if (!getProject()?.Partitions.find(p => getPartitionName(p, "NAME_OVERRIDE") === "SRAM")) { %>
    SRAM        (rwx) : ORIGIN = 0x00000000, LENGTH = 0x00000000 /* Section not defined. */
<% } %>
<% if (!getProject()?.Partitions.find(p => getPartitionName(p, "NAME_OVERRIDE") === "SPID")) { %>
