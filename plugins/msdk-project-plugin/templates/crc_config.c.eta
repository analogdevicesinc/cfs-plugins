// Return the endianness setting for the CRC.
function getCRCEndian() {
  return getPeriConfigValue(it.instance, "BIT_ORDER", "LSB_FIRST") === "MSB_FIRST" ? "CRC_MSB_FIRST" : "CRC_LSB_FIRST";
}

// Return the byte swap setting for the CRC input value.
function getCRCByteSwapIn() {
  return getPeriConfigValue(it.instance, "BYTE_ORDER_IN", "LS_BYTE_FIRST") === "MS_BYTE_FIRST" ? "CRC_MSB_FIRST" : "CRC_LSB_FIRST";
}

// Return the byte swap setting for the CRC output value.
function getCRCByteSwapOut() {
  return getPeriConfigValue(it.instance, "BYTE_ORDER_OUT", "NOT_SWAPPED") === "SWAPPED" ? "CRC_MSB_FIRST" : "CRC_LSB_FIRST";
}

// Return the CRC polynomial in hexadecimal.
function getCRCPoly() {
  return getPeriConfigValue(it.instance, "POLY", "0xEDB88320").replace(/\s+/g, "");
}

// Return the DMA used for the CRC peripheral.
function getCRC_DMA() {
  return getPeriConfigValue(it.instance, "DMA", "DMA0");
}
%>
<% if (isUnassignedPeripheralClockSetTo(it.instance, it.enable, "TRUE")) { %>
  /* The <%= it.instance %> peripheral is enabled on the clock canvas but is
   * not assigned to any core. In order to generate configuration code, please
   * assign the peripheral to a core.
   */

<% } else if (getAssignedPeripheral(it.instance)) { %>
  { /* Configure <%= it.instance %>.
<%   if (getPeripheralDescription(it.instance)) { %>
     * This peripheral is used for <%= getPeripheralDescription(it.instance) %>.
<%   } %>
<%   if (!isPeripheralClockSetTo(it.instance, it.enable, "TRUE")) { %>
     * Note: This peripheral was not enabled on the clock configuration canvas.
     * Nonetheless, as a result of the following configuration, the peripheral will be
     * clocked on.
<%   } %>
     */

    /* Initialize the peripheral. */
<%   if (it.msdkInflectionPoint(it.datamodel.Name) === "MAX32657") { %>
    result = MXC_CRC_Init(MXC_<%= getCRC_DMA() %>);
<%   } else { %>
    result = MXC_CRC_Init();
<%   } %>
    if (result != E_NO_ERROR) {
      return result;
    }

    /* Set the bit order. */
    MXC_CRC_SetDirection(<%= getCRCEndian() %>);

    /* Set the byte swap for input data. */
    MXC_CRC_SwapDataIn(<%= getCRCByteSwapIn() %>);

    /* Set the byte swap for output value. */
    MXC_CRC_SwapDataOut(<%= getCRCByteSwapOut() %>);

    /* Set the polynomial used for CRC. */
    MXC_CRC_SetPoly(<%= getCRCPoly() %>);
  }

<% } %>
