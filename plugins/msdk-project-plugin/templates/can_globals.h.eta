%>
<%
  eval(this.render("templates/can_common.js"));
%>
<% if (getAssignedPeripheral(it.instance) && (getCANUnitCallback() !== "NULL" || getCANObjCallback() !== "NULL")) { %>
/* REQUIRED: <%= it.instance %> callback function declarations
 * 
 * You MUST implement these functions in your user code (e.g., main.c).
 * The build will fail with linker errors until these are defined.
 */

<%   if (getCANUnitCallback() !== "NULL") { %>
/* <%= it.instance %> Unit event callback
 * Called when CAN unit events occur
 * @param can_idx: CAN peripheral index
 * @param event: Event flags indicating what occurred
 */
extern void <%= getCANUnitCallback() %>(uint32_t can_idx, uint32_t event);

<%   } %>
<%   if (getCANObjCallback() !== "NULL") { %>
/* <%= it.instance %> Object event callback
 * Called when CAN message object events occur
 * @param can_idx: CAN peripheral index
 * @param event: Event flags indicating what occurred
 */
extern void <%= getCANObjCallback() %>(uint32_t can_idx, uint32_t event);

<%   } %>
<% } %>