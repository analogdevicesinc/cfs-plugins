{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "module": "Node16",
    "allowJs": true,
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "target": "es2022",
    "moduleResolution": "Node16",
    "types": ["node"],
    "skipLibCheck": true,
    "strictPropertyInitialization": false,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": ["./**/*.ts"],
  "exclude": ["**/*.test.ts", "dist"],
  "ts-node": {
    "esm": true
  }
}
