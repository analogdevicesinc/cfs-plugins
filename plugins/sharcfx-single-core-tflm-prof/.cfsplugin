  "features": {
    "workspace": {
      "files": [
        {
          "src": "files/sharcfx/scripts/gen-xt-substitute-path.sh",
          "dst": "sfx/.vscode/gen-xt-substitute-path.sh"
        },
        {
          "src": "files/sfx/README.md",
          "dst": "sfx/README.md"
        },
        {
          "src": "files/sfx/specs",
          "dst": "sfx/src/linker"
        },
        {
          "src": "files/sfx/model.tflite",
          "dst": "sfx/model.tflite"
        },
        {
          "src": "files/sfx/dataset.bin",
          "dst": "sfx/dataset.bin"
        },
        {
          "src": "files/gdb_toolbox/configs/memory-dump.json",
          "dst": ".cfs/gdb_toolbox/configs/memory-dump.json"
        },
        {
          "src": "files/gdb_toolbox/configs/register-dump.json",
          "dst": ".cfs/gdb_toolbox/configs/register-dump.json"
        },
        {
          "src": "files/gdb_toolbox/configs/fault-analyzer.json",
          "dst": ".cfs/gdb_toolbox/configs/fault-analyzer.json"
        },
        {
          "src": "files/gdb_toolbox/gdb/fault-analyzer-xtensa.gdb",
          "dst": ".cfs/gdb_toolbox/gdb/fault-analyzer-xtensa.gdb"
        },
        {
          "src": "files/gdb_toolbox/configs/fatal-error.json",
          "dst": ".cfs/gdb_toolbox/configs/fatal-error.json"
        },
        {
          "src": "files/gdb_toolbox/gdb/fatal-error-xtensa.gdb",
          "dst": ".cfs/gdb_toolbox/gdb/fatal-error-xtensa.gdb"
        },
        {
          "src": "files/.cfsdependencies",
          "dst": ".cfs"
        }
      ],
      "templates": [
        {
          "src": "templates/workspace-name.code-workspace.eta",
          "dst": "${context.workspaceName}.code-workspace"
        },
        {
          "src": "templates/sfx.cfsconfig.eta",
          "dst": ".cfs/${context.soc.toLowerCase()}-${context.package.toLowerCase()}.cfsconfig"
        },
        {
          "src": "templates/launch.json.eta",
          "dst": "sfx/.vscode/launch.json"
        },
        {
          "src": "templates/settings.json.eta",
          "dst": "sfx/.vscode/settings.json"
        },
        {
          "src": "templates/cfs.tasks.json.eta",
          "dst": "sfx/.vscode/cfs.tasks.json"
        },
        {
          "src": "templates/main.cpp.eta",
          "dst": "sfx/src/main.cpp"
        },
        {
          "src": "templates/system/adi_initialize.c.eta",
          "dst": "sfx/src/system/adi_initialize.c"
        },
        {
          "src": "templates/system/adi_initialize.h.eta",
          "dst": "sfx/src/system/adi_initialize.h"
        },
        {
          "src": "templates/project.mk.eta",
          "dst": "sfx/project.mk"
        },
        {
          "src": "templates/Makefile.eta",
          "dst": "sfx/Makefile"
        },
        {
          "src": "templates/c_cpp_properties.json.eta",
          "dst": "sfx/.vscode/c_cpp_properties.json"
        }
      ]
    }
  }
}
