{
  "name": "Analyze Faults",
  "description": "Analyzes faults and exceptions in the target application.",
  "version": "1.0.0",
  "arch": ["arm", "xtensa"],
  "commands": [
    {
      "command": "source {defaultScriptsDirectory}/fault-analyzer-{arch}.gdb",
      "actions": [
        {
          "type": "appendFile",
          "filePath": "gdb_toolbox/reports/fault_analyzer.md",
          "content": "${markdownReport}"
        },
        {
          "type": "log",
          "message": "Fault analysis written to gdb_toolbox/reports/fault_analyzer.md"
        },
        {
          "type": "showMessage",
          "level": "info",
          "message": "Fault analysis completed successfully. File saved to gdb_toolbox/reports/fault_analyzer.md."
        }
      ]
    }
  ]
}
