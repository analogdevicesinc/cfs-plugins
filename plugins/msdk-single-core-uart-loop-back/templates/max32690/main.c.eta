/**
 * @file    main.c
 * @brief   UART!
 * @details This example demonstrates the UART Loopback Test.
 */

/***** Includes *****/
#include <stdio.h>
#include <stdint.h>
#include <string.h>
#include "mxc_device.h"
#include "led.h"
#include "board.h"
#include "mxc_delay.h"
#include "uart.h"
#include "dma.h"
#include "nvic_table.h"

/***** Definitions *****/
// to enable DMA, define in project.mk
// INTERRUPT is default in project.mk

#define UART_BAUD 115200
#define BUFF_SIZE 1024

/***** Globals *****/
volatile int READ_FLAG;
volatile int DMA_FLAG;

/***** Functions *****/
#ifdef DMA
void DMA_Handler(void)
{
    MXC_DMA_Handler();
    DMA_FLAG = 0;
}
#else
<% if (it.board.toLowerCase() === "ad-apard32690-sl") { %>
void UART0_Handler(void)
{
    MXC_UART_AsyncHandler(MXC_UART0);
}
#endif
<% } else { %>
void UART2_Handler(void)
{
    MXC_UART_AsyncHandler(MXC_UART2);
}
#endif
<% } %>

void readCallback(mxc_uart_req_t *req, int error)
{
    READ_FLAG = error;
}
/******************************************************************************/
int main(void)
{
    int error, i, fail = 0;
    uint8_t TxData[BUFF_SIZE];
    uint8_t RxData[BUFF_SIZE];

    printf("\n\n**************** UART Example ******************\n");
    printf("This example sends data from one UART to another\n");
    printf("\nThe green LED will illuminate for successful transaction.\n");
    printf("The red LED will illuminate if transaction failed.\n");
<% if (it.board.toLowerCase() === "ad-apard32690-sl") { %>
    printf("\nHardware Setup Instructions:\n");
    printf("1. Remove P38 header and P50 header. \n");
    printf("2. Connect UART2 TX (Pin 1 of P38) to UART0 RX (Pin 3 of P50).\n");
    printf("3. Ensure board is powered and UART configuration matches. \n");
<% } else { %>
    printf("\nRemove JP7(RX_EN) header.\n");
    printf("Connect UART0 to UART2 (P2.12->P1.9) for this example.\n\n");
<% } %>

    printf("\n-->UART Baud \t: %d Hz\n", UART_BAUD);
    printf("\n-->Test Length \t: %d bytes\n", BUFF_SIZE);

    // Initialize the data buffers
    for (i = 0; i < BUFF_SIZE; i++) {
        TxData[i] = i;
    }

    memset(RxData, 0x0, BUFF_SIZE);

#ifdef DMA
    MXC_DMA_ReleaseChannel(0);
    MXC_NVIC_SetVector(DMA0_IRQn, DMA_Handler);
    NVIC_EnableIRQ(DMA0_IRQn);
#else
<% if (it.board.toLowerCase() === "ad-apard32690-sl") { %>
    NVIC_ClearPendingIRQ(UART0_IRQn);
    NVIC_DisableIRQ(UART0_IRQn);
    MXC_NVIC_SetVector(UART0_IRQn, UART0_Handler);
    NVIC_EnableIRQ(UART0_IRQn);
<% } else { %>
    NVIC_ClearPendingIRQ(UART2_IRQn);
    NVIC_DisableIRQ(UART2_IRQn);
    MXC_NVIC_SetVector(UART2_IRQn, UART2_Handler);
    NVIC_EnableIRQ(UART2_IRQn);
<% } %>
#endif

    mxc_uart_req_t read_req;
<% if (it.board.toLowerCase() === "ad-apard32690-sl") { %>
    read_req.uart = MXC_UART0;
<% } else { %>
    read_req.uart = MXC_UART2;
<% } %>
    read_req.rxData = RxData;
    read_req.rxLen = BUFF_SIZE;
    read_req.txLen = 0;
    read_req.callback = readCallback;

    mxc_uart_req_t write_req;
<% if (it.board.toLowerCase() === "ad-apard32690-sl") { %>
    write_req.uart = MXC_UART2;
<% } else { %>
    write_req.uart = MXC_UART0;
<% } %>
    write_req.txData = TxData;
    write_req.txLen = BUFF_SIZE;
    write_req.rxLen = 0;
    write_req.callback = NULL;

    READ_FLAG = 1;
    DMA_FLAG = 1;

#ifdef DMA
    error = MXC_UART_TransactionDMA(&read_req);
#else
    error = MXC_UART_TransactionAsync(&read_req);
#endif

    if (error != E_NO_ERROR) {
        printf("-->Error starting async read: %d\n", error);
        printf("-->Example Failed\n");
        return error;
    }

    error = MXC_UART_Transaction(&write_req);

    if (error != E_NO_ERROR) {
        printf("-->Error starting sync write: %d\n", error);
        printf("-->Example Failed\n");
        return error;
    }

#ifdef DMA

    while (DMA_FLAG) {}

#else

    while (READ_FLAG) {}

    if (READ_FLAG != E_NO_ERROR) {
        printf("-->Error with UART_ReadAsync callback; %d\n", READ_FLAG);
        fail++;
    }

#endif

    if ((error = memcmp(RxData, TxData, BUFF_SIZE)) != 0) {
        printf("-->Error verifying Data: %d\n", error);
        fail++;
    } else {
        printf("-->Data verified\n");
    }

    if (fail != 0) {
        LED_On(LED_RED); // indicates FAIL
        printf("\n-->Example Failed\n");
        return E_FAIL;
    }

    LED_On(LED_GREEN); // indicates SUCCESS
    printf("\n-->Example Succeeded\n");
    return E_NO_ERROR;
}
