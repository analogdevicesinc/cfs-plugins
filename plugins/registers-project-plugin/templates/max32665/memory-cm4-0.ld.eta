%>
    PAL_NVM_DB  (r)   : ORIGIN = 0x00000000, LENGTH = 0x00000000 /* Section not defined. */
    SPIX        (rx)  : ORIGIN = 0x08000000, LENGTH = 128M
    OTP         (rwx) : ORIGIN = 0x00000000, LENGTH = 0x00000000 /* Section not defined. */
    ARM_SHARED  (rwx) : ORIGIN = 0x00000000, LENGTH = 0x00000000 /* Section not defined. */
    SDMA_SHARED (rwx) : ORIGIN = 0x00000000, LENGTH = 0x00000000 /* Section not defined. */
    SDMA_DATA   (rwx) : ORIGIN = 0x00000000, LENGTH = 0x00000000 /* Section not defined. */
    SDMA_CODE   (rwx) : ORIGIN = 0x00000000, LENGTH = 0x00000000 /* Section not defined. */
    SPID        (rw)  : ORIGIN = 0x80000000, LENGTH = 512M
    FLASH (r)   : ORIGIN = 0x10000000, LENGTH = 0x00100000 /* FLASH */
    SRAM  (rw)  : ORIGIN = 0x20000000, LENGTH = 0x0008c000 /* SRAM  */

