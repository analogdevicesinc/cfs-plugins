<% const toolchain = it.coreId === "RV" ? "riscv64-zephyr-elf" : "arm-zephyr-eabi"; %>
{
  "env": {
    "cfs.project.toolchain.path": "",
    "cfs.zephyr.workspace.path": ""
  },
  "configurations": [
    {
      "name": "Win32",
      "includePath": [
        "${workspaceFolder}/**",
        "${env:cfs.project.toolchain.path}/gnu/<%= toolchain %>/<%= toolchain %>/include",
        "${env:cfs.zephyr.workspace.path}/include/zephyr",
        "${env:cfs.zephyr.workspace.path}/include"
      ],
      "compileCommands": "${workspaceFolder}/build/compile_commands.json",
      "defines": ["${config:cfs.project.board}", "__GNUC__"],
      "intelliSenseMode": "gcc-arm",
      "compilerPath": "${env:cfs.project.toolchain.path}/gnu/<%= toolchain %>/bin/<%= toolchain %>-gcc.exe",
      "browse": {
        "path": [
          "${workspaceFolder}/**",
          "${env:cfs.project.toolchain.path}/gnu/<%= toolchain %>/<%= toolchain %>/include",
          "${env:cfs.zephyr.workspace.path}/include/zephyr",
          "${env:cfs.zephyr.workspace.path}/include"
        ]
      }
    },
    {
      "name": "Linux",
      "includePath": [
        "${workspaceFolder}/**",
        "${env:cfs.project.toolchain.path}/gnu/<%= toolchain %>/<%= toolchain %>/include",
        "${env:cfs.zephyr.workspace.path}/include/zephyr",
        "${env:cfs.zephyr.workspace.path}/include"
      ],
      "compileCommands": "${workspaceFolder}/build/compile_commands.json",
      "defines": ["${config:cfs.project.board}", "__GNUC__"],
      "intelliSenseMode": "gcc-arm",
      "compilerPath": "${env:cfs.project.toolchain.path}/gnu/<%= toolchain %>/bin/<%= toolchain %>-gcc",
      "browse": {
        "path": [
          "${workspaceFolder}/**",
          "${env:cfs.project.toolchain.path}/gnu/<%= toolchain %>/<%= toolchain %>/include",
          "${env:cfs.zephyr.workspace.path}/include/zephyr",
          "${env:cfs.zephyr.workspace.path}/include"
        ]
      }
    },
    {
      "name": "Mac",
      "includePath": [
        "${workspaceFolder}/**",
        "${env:cfs.project.toolchain.path}/gnu/<%= toolchain %>/<%= toolchain %>/include",
        "${env:cfs.zephyr.workspace.path}/include/zephyr",
        "${env:cfs.zephyr.workspace.path}/include"
      ],
      "compileCommands": "${workspaceFolder}/build/compile_commands.json",
      "defines": ["${config:cfs.project.board}", "__GNUC__"],
      "intelliSenseMode": "gcc-arm",
      "compilerPath": "${env:cfs.project.toolchain.path}/gnu/<%= toolchain %>/bin/<%= toolchain %>-gcc",
      "browse": {
        "path": [
          "${workspaceFolder}/**",
          "${env:cfs.project.toolchain.path}/gnu/<%= toolchain %>/<%= toolchain %>/include",
          "${env:cfs.zephyr.workspace.path}/include/zephyr",
          "${env:cfs.zephyr.workspace.path}/include"
        ]
      },
      "macFrameworkPath": [
        "/System/Library/Frameworks",
        "/Library/Frameworks"
      ]
    }
  ],
  "version": 4
}
