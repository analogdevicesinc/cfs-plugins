<%~ include("@normalizeSoc", it) %>
{
  "version": 1,
  "packages": [
    {
      "name": "zephyr",
      "version": "<%= it.zephyrInflectionPoint(it.soc) === "MAX32657" ? '4.4.0-b.1' : '~4.4.2' %>"
    },
    {
      "name": "<%= it.coreId === "RV" ? "zephyr_riscv_toolchain" : "zephyr_arm_toolchain" %>",
      "version": "~1.0.3"
    },
    {
      "name": "cfs_base_data_models",
      "version": "^2.4.0"
    },
    {
      "name": "cfs_base_plugins",
      "version": "^2.4.0"
    }
  ]
}
