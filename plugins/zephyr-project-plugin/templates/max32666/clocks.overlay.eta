/* System clock configuration */
&gcr {
<% if (isSystemClockSetTo("SYS_OSC Mux", "MUX", "LPO")) { %>
	clocks = <&clk_iso>;
<% } else if (isSystemClockSetTo("SYS_OSC Mux", "MUX", "OBRC")) { %>
	clocks = <&clk_ibro>;
<% } else if (getClockSetting("SYS_OSC Mux", "MUX", "HSO") === "HSO") { %>
	clocks = <&clk_ipo>;
<% } else { %>
	clocks = <&clk_<%= getClockSetting("SYS_OSC Mux", "MUX", "HSO").toLowerCase() %>>;
<% } %>
	sysclk-prescaler = <<%= getClockSetting("PRESCALER", "DIV", "1") %>>;
};
